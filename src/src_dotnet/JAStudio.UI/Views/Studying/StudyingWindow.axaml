<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:studying="clr-namespace:JAStudio.UI.ViewModels.Studying"
        xmlns:views="clr-namespace:JAStudio.UI.Views.Studying"
        x:Class="JAStudio.UI.Views.Studying.StudyingWindow"
        x:DataType="studying:StudyingWindowViewModel"
        Title="Studying"
        Width="900"
        Height="560">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <views:SyncButton DataContext="{Binding SyncButton}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding SyncButton.WhyTheSyncDidNotRun}" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding WhatTheLastSyncDid}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Study-notes in Anki that belong to no note" FontWeight="Bold" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Show them in Anki's browser" Command="{Binding ShowThemInAnkisBrowserCommand}"
                    ToolTip.Tip="Opens Anki's browser on these Anki notes, to look at them there, and to delete or mend them." />
        </StackPanel>

        <DataGrid ItemsSource="{Binding StudyNotesOfNoNote}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,6,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="studying:StudyNoteOfNoNoteRow" Header="Anki note id" Binding="{Binding AnkiNoteId}" Width="Auto" />
                <DataGridTemplateColumn Header="Question" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="studying:StudyNoteOfNoNoteRow">
                            <TextBlock Text="{Binding Question}" FontFamily="{StaticResource JapaneseFont}" VerticalAlignment="Center" Margin="4,2"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Question}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="studying:StudyNoteOfNoNoteRow" Header="jas_note_id" Binding="{Binding JasNoteId}" Width="2*" />
                <DataGridTextColumn x:DataType="studying:StudyNoteOfNoNoteRow" Header="Why it belongs to no note" Binding="{Binding WhyItBelongsToNoNote}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</Window>
