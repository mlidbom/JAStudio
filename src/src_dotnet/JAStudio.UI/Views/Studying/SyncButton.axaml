<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studying="clr-namespace:JAStudio.UI.ViewModels.Studying"
             x:Class="JAStudio.UI.Views.Studying.SyncButton"
             x:DataType="studying:SyncButtonViewModel"
             IsVisible="{Binding IsOffered}">

    <UserControl.Resources>
        <!-- Two arrows in a circle, and a check mark: the "sync" and "check" icons of Material Design Icons, drawn in a 24 by 24 box. -->
        <StreamGeometry x:Key="TwoArrowsInACircle">M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z</StreamGeometry>
        <StreamGeometry x:Key="CheckMark">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
        <SolidColorBrush x:Key="MarkedAsSynced" Color="#2E9E44" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="PathIcon.icon">
            <Setter Property="Data" Value="{StaticResource TwoArrowsInACircle}" />
        </Style>
        <Style Selector="PathIcon.icon.markedAsSynced">
            <Setter Property="Data" Value="{StaticResource CheckMark}" />
            <Setter Property="Foreground" Value="{StaticResource MarkedAsSynced}" />
        </Style>
        <!-- Last, so that a sync under way shows the arrows, turning, whatever the last sync did. -->
        <Style Selector="PathIcon.icon.syncing">
            <Setter Property="Data" Value="{StaticResource TwoArrowsInACircle}" />
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="-360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.markedAsSynced">
            <Setter Property="BorderBrush" Value="{StaticResource MarkedAsSynced}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="6">
        <Button IsVisible="{Binding OffersTheCollectionAnkiHasOpen}" Command="{Binding WorkWithTheCollectionAnkiHasOpenCommand}"
                Content="Use the collection Anki has open" Padding="8,2"
                ToolTip.Tip="JAStudio then works with the collection Anki has open, and reads its study-notes, so that the notes show what that collection holds. Nothing is written to Anki until the next sync." />

        <Button Command="{Binding SyncCommand}" ToolTip.Tip="{Binding ToolTip}" ToolTip.ShowOnDisabled="True"
                ContextRequested="OnContextRequested" Padding="8,2" BorderThickness="1"
                Classes.markedAsSynced="{Binding IsMarkedAsSynced}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="icon" Classes.markedAsSynced="{Binding IsMarkedAsSynced}" Classes.syncing="{Binding IsSyncing}"
                          Width="14" Height="14" VerticalAlignment="Center">
                    <PathIcon.RenderTransform>
                        <RotateTransform />
                    </PathIcon.RenderTransform>
                </PathIcon>
                <TextBlock Text="Sync" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>

</UserControl>
