<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JAStudio.UI.Views.NoteViewerWindow"
        Title="Note viewer"
        Width="1000" Height="1100"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4">
            <Button x:Name="BackButton" Content="◀" ToolTip.Tip="Back" IsEnabled="False" Click="OnBackClick" />
            <Button x:Name="ForwardButton" Content="▶" ToolTip.Tip="Forward" IsEnabled="False" Click="OnForwardClick" />
        </StackPanel>

        <NativeWebView x:Name="WebView" />
    </DockPanel>

</Window>
