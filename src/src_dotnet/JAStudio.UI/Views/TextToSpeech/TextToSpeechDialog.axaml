<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:textToSpeech="clr-namespace:JAStudio.UI.ViewModels.TextToSpeech"
        xmlns:textToSpeechViews="clr-namespace:JAStudio.UI.Views.TextToSpeech"
        x:Class="JAStudio.UI.Views.TextToSpeech.TextToSpeechDialog"
        x:DataType="textToSpeech:TextToSpeechForANoteViewModel"
        Title="{Binding Title}"
        Width="860"
        Height="580">

    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" Click="OnClose" HorizontalAlignment="Right" Margin="0,8,0,0" />
        <textToSpeechViews:TextToSpeechForANoteView x:Name="ForTheNote" />
    </DockPanel>

</Window>
