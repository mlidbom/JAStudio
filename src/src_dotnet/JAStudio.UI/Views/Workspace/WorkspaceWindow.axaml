<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JAStudio.UI.ViewModels.Workspace"
        xmlns:workspace="clr-namespace:JAStudio.UI.Views.Workspace"
        x:Class="JAStudio.UI.Views.Workspace.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="{Binding Title}"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" />

        <workspace:NoteSearchPane x:Name="NoteSearchPane" DockPanel.Dock="Left" DataContext="{Binding NoteSearch}"
                                  Width="420" MinWidth="200" />
        <!-- The note search pane's right edge: dragging it resizes the pane.
             The template draws the edge: a Thumb has no look of its own, and what isn't drawn can't be pointed at. -->
        <Thumb DockPanel.Dock="Left" Width="5" Cursor="SizeWestEast" Background="LightGray"
               IsVisible="{Binding NoteSearch.IsOpen}" DragDelta="OnNoteSearchPaneEdgeDragged">
            <Thumb.Template>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <ToggleButton DockPanel.Dock="Left" Content="Search" IsChecked="{Binding NoteSearch.IsOpen}"
                              ToolTip.Tip="Show or hide the note search (Ctrl+O)" Margin="4,2" Padding="8,2" />

                <TabStrip ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </TabStrip.Styles>
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                                        ToolTip.Tip="{Binding Header}" PointerReleased="OnTabHeaderPointerReleased">
                                <TextBlock Text="{Binding Header}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Content="✕" ToolTip.Tip="Close (Ctrl+W)" Command="{Binding CloseCommand}"
                                        Padding="4,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </DockPanel>

            <!-- Every tab's view stays here, the hidden ones invisible: see NoteTabView. Its item template is set in code-behind. -->
            <ItemsControl x:Name="TabViews" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </DockPanel>

</Window>
