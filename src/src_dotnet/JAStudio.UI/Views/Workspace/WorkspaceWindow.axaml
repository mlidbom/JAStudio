<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JAStudio.UI.ViewModels.Workspace"
        xmlns:workspace="clr-namespace:JAStudio.UI.Views.Workspace"
        xmlns:controls="clr-namespace:JAStudio.UI.Controls"
        xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
        xmlns:navigation="clr-namespace:JAStudio.UI.Views.Workspace.Navigation"
        x:Class="JAStudio.UI.Views.Workspace.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="{Binding Title}"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" />

        <navigation:NavigationPane x:Name="NavigationPane" DockPanel.Dock="Left" DataContext="{Binding Navigation}"
                                   Width="420" MinWidth="200" />
        <controls:PaneResizeEdge DockPanel.Dock="Left" ResizedPane="{Binding #NavigationPane}" ResizedPaneSide="Left"
                                 IsVisible="{Binding Navigation.IsOpen}" />

        <editorViews:EditorSection x:Name="EditorSection" DockPanel.Dock="Right" Width="480" MinWidth="250" IsVisible="{Binding IsEditorSectionOpen}" />
        <controls:PaneResizeEdge DockPanel.Dock="Right" ResizedPane="{Binding #EditorSection}" ResizedPaneSide="Right"
                                 IsVisible="{Binding IsEditorSectionOpen}" />

        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <ToggleButton DockPanel.Dock="Left" Content="Navigation" IsChecked="{Binding Navigation.IsOpen}"
                              ToolTip.Tip="Show or hide the navigation pane: the note search (Ctrl+O), and the lists the note menus' Open items show"
                              Margin="4,2" Padding="8,2" />
                <ToggleButton DockPanel.Dock="Right" Content="Editor" IsChecked="{Binding IsEditorSectionOpen}"
                              ToolTip.Tip="Show or hide the editor section (Ctrl+E)" Margin="4,2" Padding="8,2" />

                <TabStrip ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </TabStrip.Styles>
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                                        ToolTip.Tip="{Binding Header}" PointerReleased="OnTabHeaderPointerReleased">
                                <TextBlock Text="{Binding Header}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Content="✕" ToolTip.Tip="Close (Ctrl+W)" Command="{Binding CloseCommand}"
                                        Padding="4,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </DockPanel>

            <!-- Every tab's view stays here, the hidden ones invisible: see NoteTabView. Its item template is set in code-behind. -->
            <ItemsControl x:Name="TabViews" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </DockPanel>

</Window>
