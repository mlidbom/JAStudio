<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JAStudio.UI.ViewModels.Workspace"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
             xmlns:controls="clr-namespace:JAStudio.UI.Controls"
             x:Class="JAStudio.UI.Views.Workspace.NoteTabView"
             x:DataType="vm:NoteTabViewModel"
             IsVisible="{Binding IsSelected}">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="4">
            <ToggleButton DockPanel.Dock="Right" Content="Editor" IsChecked="{Binding IsEditorSectionOpen}"
                          ToolTip.Tip="Show or hide the note's editor (Ctrl+E)" Padding="8,2" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="◀" ToolTip.Tip="Back" IsEnabled="{Binding CanGoBack}" Click="OnBackClick" />
                <Button Content="▶" ToolTip.Tip="Forward" IsEnabled="{Binding CanGoForward}" Click="OnForwardClick" />
            </StackPanel>
        </DockPanel>

        <!-- The editor section: the shown note's editors, on the right of the page. -->
        <Panel x:Name="EditorSection" DockPanel.Dock="Right" Width="480" MinWidth="250" IsVisible="{Binding IsEditorSectionOpen}">
            <ContentControl Content="{Binding VocabFlagsEditor}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="editors:VocabFlagsEditorViewModel">
                        <editorViews:VocabFlagsEditor />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
            <TextBlock Text="This note has no editor in the workspace yet. Its editors are in its right-click menu."
                       TextWrapping="Wrap" Margin="8"
                       IsVisible="{Binding VocabFlagsEditor, Converter={x:Static ObjectConverters.IsNull}}" />
        </Panel>
        <controls:PaneResizeEdge DockPanel.Dock="Right" ResizedPane="{Binding #EditorSection}" ResizedPaneSide="Right"
                                 IsVisible="{Binding IsEditorSectionOpen}" />

        <NativeWebView x:Name="WebView" />
    </DockPanel>

</UserControl>
