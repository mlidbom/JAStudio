<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tagging="clr-namespace:JAStudio.UI.ViewModels.Workspace.Tagging"
             x:Class="JAStudio.UI.Views.Workspace.Tagging.NoteTagsEditor"
             x:DataType="tagging:NoteTagsEditorViewModel">

    <StackPanel Spacing="6">
        <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="tagging:TagOnTheNoteViewModel">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="8,1,2,1" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <Button Content="×" Command="{Binding RemoveCommand}" Padding="5,0" MinHeight="0"
                                    ToolTip.Tip="Removes the tag from the note" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="AddATagButton" Content="Add a tag... (Ctrl+T)" HorizontalAlignment="Left" Click="OnAddATagClicked" />
    </StackPanel>

</UserControl>
