<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabEditorSection"
             x:DataType="editors:VocabEditorSectionViewModel">

    <!-- The rows' look comes from the EditorSection this is shown in. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="6,6,6,0" IsVisible="{Binding SentencesReparser.IsReparsingSentences}">
            <TextBlock Text="Reparsing the sentences for this vocab…" />
            <ProgressBar IsIndeterminate="True" />
        </StackPanel>

        <!-- Each tab's editor is locked while the sentences are reparsed, but the tabs can still be switched. -->
        <TabControl>
            <TabItem Header="Text">
                <Panel IsEnabled="{Binding !SentencesReparser.IsReparsingSentences}">
                    <editorViews:VocabTextEditor DataContext="{Binding Text}" />
                </Panel>
            </TabItem>
            <TabItem Header="Matching">
                <Panel IsEnabled="{Binding !SentencesReparser.IsReparsingSentences}">
                    <editorViews:VocabMatchingConfigEditor DataContext="{Binding MatchingConfig}" />
                </Panel>
            </TabItem>
            <TabItem Header="Metadata">
                <Panel IsEnabled="{Binding !SentencesReparser.IsReparsingSentences}">
                    <editorViews:VocabMetadataEditor DataContext="{Binding Metadata}" />
                </Panel>
            </TabItem>
            <TabItem Header="Related">
                <Panel IsEnabled="{Binding !SentencesReparser.IsReparsingSentences}">
                    <editorViews:VocabRelatedEditor DataContext="{Binding Related}" />
                </Panel>
            </TabItem>
        </TabControl>
    </DockPanel>

</UserControl>
