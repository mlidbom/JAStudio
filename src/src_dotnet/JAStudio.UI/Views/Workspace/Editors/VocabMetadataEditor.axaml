<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
             xmlns:taggingViews="clr-namespace:JAStudio.UI.Views.Workspace.Tagging"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabMetadataEditor"
             x:DataType="editors:VocabMetadataEditorViewModel">

    <!-- The rows' look comes from the EditorSection this tab is shown in. -->
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="6">
            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc" />
                    <editorViews:UsuallyWrittenInKanaEditor DataContext="{Binding UsuallyWrittenInKana}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding MiscFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Register" />
                    <ItemsControl ItemsSource="{Binding RegisterFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Tags" />
                    <taggingViews:NoteTagsEditor DataContext="{Binding Tags}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
