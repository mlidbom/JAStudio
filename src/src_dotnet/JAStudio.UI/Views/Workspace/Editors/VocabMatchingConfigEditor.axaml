<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:matchConditions="clr-namespace:JAStudio.UI.Views.Workspace.Editors.MatchConditions"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabMatchingConfigEditor"
             x:DataType="editors:VocabMatchingConfigEditorViewModel">

    <!-- The rows' look comes from the EditorSection this tab is shown in. -->
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="6">
            <Border Classes="section">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionTitle" Text="Match-condition" />
                    <matchConditions:MatchConditionEditor DataContext="{Binding MatchConditionEditor}" />
                    <TextBlock IsVisible="{Binding !CanBeEditedRuleByRule}"
                               TextWrapping="Wrap"
                               Text="It has conditions that aren't matching rules', so the rules below can only show it. Edit it in the tree." />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Display" />
                    <ContentControl Content="{Binding YieldLastToken}" />
                    <ContentControl Content="{Binding YieldToSurface}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel IsEnabled="{Binding CanBeEditedRuleByRule}">
                    <TextBlock Classes="sectionTitle" Text="Misc matching rules" />
                    <ItemsControl ItemsSource="{Binding MiscMatchingRules}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Stem matching rules" />
                    <ContentControl Content="{Binding DictionaryFormStart}" />
                    <ItemsControl ItemsSource="{Binding StemMatchingRules}" IsEnabled="{Binding CanBeEditedRuleByRule}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Is" />
                    <ItemsControl ItemsSource="{Binding IsFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc" />
                    <ItemsControl ItemsSource="{Binding MiscFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel IsEnabled="{Binding CanBeEditedRuleByRule}">
                    <TextBlock Classes="sectionTitle" Text="String rules" />
                    <ItemsControl ItemsSource="{Binding TextSetRules}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
