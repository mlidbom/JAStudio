<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:matching="clr-namespace:JAStudio.UI.Views.Workspace.Editors.Matching"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabMatchingConfigEditor"
             x:DataType="editors:VocabMatchingConfigEditorViewModel">

    <!-- The rows' look comes from the EditorSection this tab is shown in. -->
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="6">
            <Border Classes="section">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionTitle" Text="Match-condition" />
                    <matching:ConditionCodeView x:Name="MatchCondition" DataContext="{Binding MatchCondition}" />
                    <TextBlock Text="{Binding HowToEdit}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Display" />
                    <ContentControl Content="{Binding YieldLastToken}" />
                    <ContentControl Content="{Binding YieldToSurface}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Is" />
                    <ItemsControl ItemsSource="{Binding IsFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc" />
                    <ContentControl Content="{Binding DictionaryFormStart}" />
                    <ItemsControl ItemsSource="{Binding MiscFlags}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
