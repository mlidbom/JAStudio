<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabTextEditor"
             x:DataType="editors:VocabTextEditorViewModel">

    <!-- The rows' look comes from the EditorSection this tab is shown in. -->
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="6">
            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Core" />
                    <ContentControl Content="{Binding Question}" />
                    <ContentControl Content="{Binding Disambiguation}" />
                    <ContentControl Content="{Binding Readings}" />
                    <ContentControl Content="{Binding Forms}" />
                    <ContentControl Content="{Binding PartsOfSpeech}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Corpus" />
                    <ItemsControl ItemsSource="{Binding CorpusFields}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Audio" />
                    <ItemsControl ItemsSource="{Binding AudioFields}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Notes" />
                    <ContentControl Content="{Binding TechnicalNotes}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Source" />
                    <ItemsControl ItemsSource="{Binding SourceFields}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
