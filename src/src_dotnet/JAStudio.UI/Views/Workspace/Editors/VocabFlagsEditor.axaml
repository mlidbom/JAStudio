<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:controls="clr-namespace:JAStudio.UI.Controls"
             x:Class="JAStudio.UI.Views.Workspace.Editors.VocabFlagsEditor"
             x:DataType="editors:VocabFlagsEditorViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="controls:RequireForbidControlViewModel">
            <controls:RequireForbidControl />
        </DataTemplate>
        <DataTemplate DataType="controls:TagFlagCheckBoxViewModel">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" />
        </DataTemplate>
        <DataTemplate DataType="controls:StringSetControlViewModel">
            <controls:StringSetControl Margin="0,0,0,6" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.columnTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="8" Margin="6">
            <StackPanel Spacing="4">
                <Button Content="Reparse sentences" Command="{Binding ReparseSentencesCommand}"
                        Classes.accent="{Binding SentencesNeedReparsing}"
                        ToolTip.Tip="Reparse the sentences that may contain this vocab, so that they reflect its parsing rules" />
                <TextBlock Text="Parsing rules changed. The sentences aren't reparsed yet." TextWrapping="Wrap"
                           IsVisible="{Binding SentencesNeedReparsing}" />
            </StackPanel>

            <TextBlock Classes="columnTitle" Text="Parsing" />

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Display" />
                    <ContentControl Content="{Binding YieldLastToken}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc matching rules" />
                    <ItemsControl ItemsSource="{Binding MiscMatchingRules}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Stem matching rules" />
                    <ItemsControl ItemsSource="{Binding StemMatchingRules}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Is" />
                    <ItemsControl ItemsSource="{Binding IsFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc" />
                    <ItemsControl ItemsSource="{Binding MiscFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="String rules" />
                    <ItemsControl ItemsSource="{Binding StringRules}" />
                </StackPanel>
            </Border>

            <TextBlock Classes="columnTitle" Text="Meta data" />

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Misc" />
                    <ItemsControl ItemsSource="{Binding MetadataFlags}" />
                </StackPanel>
            </Border>

            <Border Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionTitle" Text="Register" />
                    <ItemsControl ItemsSource="{Binding RegisterFlags}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
