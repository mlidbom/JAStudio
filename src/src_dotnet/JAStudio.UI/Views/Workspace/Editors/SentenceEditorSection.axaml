<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:taggingViews="clr-namespace:JAStudio.UI.Views.Workspace.Tagging"
             xmlns:parsingViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors.Parsing"
             x:Class="JAStudio.UI.Views.Workspace.Editors.SentenceEditorSection"
             x:DataType="editors:SentenceEditorSectionViewModel">

    <!-- The rows' look comes from the EditorSection this is shown in. -->
    <TabControl>
        <TabItem Header="Text">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="6">
                    <Border Classes="section">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Corpus" />
                            <ItemsControl ItemsSource="{Binding CorpusFields}" />
                            <ItemsControl ItemsSource="{Binding CorpusMedia}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Source" />
                            <ItemsControl ItemsSource="{Binding SourceFields}" />
                            <ItemsControl ItemsSource="{Binding SourceMedia}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Other" />
                            <ItemsControl ItemsSource="{Binding OtherFields}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Tags" />
                            <taggingViews:NoteTagsEditor DataContext="{Binding Tags}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Parsing">
            <parsingViews:SentenceParsingView DataContext="{Binding Parsing}" />
        </TabItem>
    </TabControl>

</UserControl>
