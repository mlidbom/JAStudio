<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:matching="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors.Matching"
             x:Class="JAStudio.UI.Views.Workspace.Editors.Matching.ConditionTreeEditor"
             x:DataType="matching:ConditionTreeEditorViewModel">

    <StackPanel Spacing="4">
        <TreeView x:Name="ConditionTree"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
            <TreeView.Resources>
                <!-- Each line is indented as code is, in characters, by the spaces it starts with (ConditionTreeLineViewModel.CodeColumn), so the tree
                     itself indents no level: the expand arrows stay in a column of their own, at the left. -->
                <x:Double x:Key="TreeViewItemIndent">0</x:Double>
            </TreeView.Resources>
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
                <!-- The selection's blue hides a shared-condition's name, as the code's styles in App.axaml color it: on the selected line, the
                     selection's own color, and the highlight sets the line apart. The line's content is the item's child, and the lines under it are
                     items of their own, so they keep the color. -->
                <Style Selector="TreeViewItem:selected > StackPanel TextBlock.code.sharedConditionName">
                    <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForegroundSelected}" />
                </Style>
                <Style Selector="ToggleButton.definition">
                    <Setter Property="Content" Value="▸" />
                </Style>
                <Style Selector="ToggleButton.definition:checked">
                    <Setter Property="Content" Value="▾" />
                </Style>
                <Style Selector="TextBlock.checkMark.met">
                    <Setter Property="Foreground" Value="#2E9E4F" />
                </Style>
                <Style Selector="TextBlock.checkMark.notMet">
                    <Setter Property="Foreground" Value="#D9534F" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="matching:ConditionTreeLineViewModel" ItemsSource="{Binding Children}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- While the tree is checked, such as against a word in a sentence, whether each line's condition is met: a column of its
                                 own at the left, since each line is indented by the spaces in front of its code. -->
                            <TextBlock Classes="checkMark" Text="{Binding CheckMark}" Width="14" FontWeight="Bold" VerticalAlignment="Center"
                                       Classes.met="{Binding IsMetWhereTheTreeIsChecked}" Classes.notMet="{Binding IsNotMetWhereTheTreeIsChecked}"
                                       IsVisible="{Binding Check, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding ShownCode}" ItemTemplate="{StaticResource CodeLine}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="ShowTheDefinition" Classes="definition" Padding="4,0" Focusable="False"
                                          IsVisible="{Binding IsASharedCondition}"
                                          ToolTip.Tip="Show the shared-condition's definition here" />
                            <Button Content="+" Padding="6,0" IsVisible="{Binding IsGroup}"
                                    ToolTip.Tip="Add a condition (+)"
                                    Click="OnAddButtonClicked" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ShownDefinitionOfTheSharedCondition}" ItemTemplate="{StaticResource CodeLine}"
                                      IsVisible="{Binding #ShowTheDefinition.IsChecked}" Opacity="0.6" Margin="0,2" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Text="{Binding HowToEdit}" TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>

</UserControl>
