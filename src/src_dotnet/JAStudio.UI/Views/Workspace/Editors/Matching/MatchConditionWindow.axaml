<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:matching="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors.Matching"
        xmlns:matchingViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors.Matching"
        xmlns:checkingViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors.Matching.Checking"
        x:Class="JAStudio.UI.Views.Workspace.Editors.Matching.MatchConditionWindow"
        x:DataType="matching:MatchConditionWindowViewModel"
        Title="{Binding Title}"
        Width="1400"
        Height="1000">

    <ScrollViewer Margin="10">
        <StackPanel Spacing="12">
            <checkingViews:WordToCheckAgainstView x:Name="WordToCheckAgainst" DataContext="{Binding WordToCheckAgainst}" />
            <!-- The match-condition can't be changed while the vocab's sentences are reparsed for the last change. -->
            <Panel IsEnabled="{Binding !SentencesReparser.IsReparsingSentences}">
                <matchingViews:ConditionTreeEditor DataContext="{Binding MatchConditionEditor}" />
            </Panel>
        </StackPanel>
    </ScrollViewer>

</Window>
