<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JAStudio.UI.ViewModels.Workspace"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
             xmlns:controls="clr-namespace:JAStudio.UI.Controls"
             x:Class="JAStudio.UI.Views.Workspace.Editors.EditorSection"
             x:DataType="vm:WorkspaceViewModel">

    <!-- The editors' rows, and the look of their sections, shared by every note type's editors. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="controls:RequireForbidControlViewModel">
            <controls:RequireForbidControl />
        </DataTemplate>
        <DataTemplate DataType="controls:TagFlagCheckBoxViewModel">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" />
        </DataTemplate>
        <DataTemplate DataType="controls:StringSetControlViewModel">
            <controls:StringSetControl Margin="0,0,0,6" />
        </DataTemplate>
        <DataTemplate DataType="controls:TextFieldEditorViewModel">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,2" />
                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Hint}" TextWrapping="Wrap"
                         AcceptsReturn="{Binding IsMultiLine}" Classes.multiLine="{Binding IsMultiLine}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBox.multiLine">
            <Setter Property="MinHeight" Value="60" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ContentControl Content="{Binding SelectedTab.EditorSection, FallbackValue={x:Null}}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="editors:VocabEditorSectionViewModel">
                    <editorViews:VocabEditorSection />
                </DataTemplate>
                <DataTemplate DataType="editors:KanjiEditorSectionViewModel">
                    <editorViews:KanjiEditorSection />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock Text="The shown note has no editor in the workspace yet. Its editors are in its right-click menu."
                   TextWrapping="Wrap" Margin="8"
                   IsVisible="{Binding SelectedTab.EditorSection, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />
    </Panel>

</UserControl>
