<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JAStudio.UI.ViewModels.Workspace"
             xmlns:editors="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors"
             xmlns:editorViews="clr-namespace:JAStudio.UI.Views.Workspace.Editors"
             xmlns:noteFields="clr-namespace:JAStudio.UI.Controls.NoteFields"
             x:Class="JAStudio.UI.Views.Workspace.Editors.EditorSection"
             x:DataType="vm:WorkspaceViewModel">

    <!-- The editors' rows, and the look of their sections, shared by every note type's editors. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="noteFields:RequireForbidFlagEditorViewModel">
            <noteFields:RequireForbidFlagEditor />
        </DataTemplate>
        <DataTemplate DataType="noteFields:TagFlagEditorViewModel">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" />
        </DataTemplate>
        <DataTemplate DataType="noteFields:StringSetEditorViewModel">
            <noteFields:StringSetEditor Margin="0,0,0,6" />
        </DataTemplate>
        <DataTemplate DataType="noteFields:EnteredFormsEditorViewModel">
            <noteFields:EnteredFormsEditor Margin="0,0,0,6" />
        </DataTemplate>
        <!-- Before the TextFieldEditorViewModel's template, which would show it too, since it is one. -->
        <DataTemplate DataType="noteFields:TextToSpeechAudioFieldEditorViewModel">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,2" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="TTS..." Command="{Binding OpenTheTextToSpeechDialogCommand}" Margin="6,0,0,0"
                            ToolTip.Tip="Generate new TTS audio for the note, listen to the attempts, and keep one" />
                    <TextBox Text="{Binding Text}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="noteFields:TextFieldEditorViewModel">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,2" />
                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Hint}" TextWrapping="Wrap"
                         AcceptsReturn="{Binding IsMultiLine}" />
            </StackPanel>
        </DataTemplate>
        <!-- Committed with Enter here, and when the keyboard leaves the text box in the code-behind. -->
        <DataTemplate DataType="noteFields:CommittingTextFieldEditorViewModel">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,2" />
                <TextBox Text="{Binding Text}" Classes.uncommitted="{Binding HasUncommittedText}"
                         ToolTip.Tip="Saved when you press Enter or leave the box. Light red until then.">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- The theme sets the box's background in its template, differently while hovered or focused, so each state is overridden there. -->
        <Style Selector="TextBox.uncommitted /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFDCDC" />
        </Style>
        <Style Selector="TextBox.uncommitted:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFDCDC" />
        </Style>
        <Style Selector="TextBox.uncommitted:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFDCDC" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ContentControl Content="{Binding SelectedTab.EditorSection, FallbackValue={x:Null}}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="editors:VocabEditorSectionViewModel">
                    <editorViews:VocabEditorSection />
                </DataTemplate>
                <DataTemplate DataType="editors:KanjiEditorSectionViewModel">
                    <editorViews:KanjiEditorSection />
                </DataTemplate>
                <DataTemplate DataType="editors:SentenceEditorSectionViewModel">
                    <editorViews:SentenceEditorSection />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock Text="The shown page has no note to edit."
                   TextWrapping="Wrap" Margin="8"
                   IsVisible="{Binding SelectedTab.EditorSection, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />
    </Panel>

</UserControl>
