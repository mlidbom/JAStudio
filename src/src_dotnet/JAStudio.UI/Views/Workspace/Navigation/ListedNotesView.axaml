<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation"
             x:Class="JAStudio.UI.Views.Workspace.Navigation.ListedNotesView"
             x:DataType="navigation:ListedNotesViewModel">

    <DockPanel>
        <!-- One tab per note type, for the types with notes, when there's more than one. -->
        <TabStrip DockPanel.Dock="Top" ItemsSource="{Binding OfEachType}" SelectedItem="{Binding Shown}"
                  IsVisible="{Binding ShowsSeveralTypes}" Margin="0,0,0,4">
            <TabStrip.Styles>
                <Style Selector="TabStripItem" x:DataType="navigation:ListedNotesOfOneTypeViewModel">
                    <Setter Property="IsVisible" Value="{Binding HasNotes}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="8,3" />
                </Style>
            </TabStrip.Styles>
            <TabStrip.ItemTemplate>
                <DataTemplate x:DataType="navigation:ListedNotesOfOneTypeViewModel">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabStrip.ItemTemplate>
        </TabStrip>

        <ContentControl Content="{Binding Shown}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="navigation:ListedNotesOfOneTypeViewModel">
                    <ListBox ItemsSource="{Binding Notes}"
                             SelectedItem="{Binding SelectedNote}"
                             DoubleTapped="OnListedNoteDoubleTapped"
                             BorderThickness="1" BorderBrush="Gray">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding OpenSelectedNoteCommand}" />
                        </ListBox.KeyBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="navigation:ListedNoteViewModel">
                                <StackPanel Background="Transparent" PointerReleased="OnListedNotePointerReleased">
                                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource JapaneseFont}" FontSize="18" />
                                    <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>

</UserControl>
