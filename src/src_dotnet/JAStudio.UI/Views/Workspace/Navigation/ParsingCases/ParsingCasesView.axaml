<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parsingCases="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation.ParsingCases"
             xmlns:resultsViews="clr-namespace:JAStudio.UI.Views.Workspace.Navigation.SearchResults"
             x:Class="JAStudio.UI.Views.Workspace.Navigation.ParsingCases.ParsingCasesView"
             x:DataType="parsingCases:ParsingCasesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <!-- The toggles of a group of filters, in a row that wraps. -->
        <DataTemplate x:Key="FilterToggle" x:DataType="parsingCases:ParsingCaseFilterViewModel">
            <ToggleButton Classes="filter" IsChecked="{Binding IsOn}" Content="{Binding Text}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="FiltersInARow">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="DataGrid">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Gray" />
        </Style>
        <Style Selector="ToggleButton.filter">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style Selector="TextBlock.filterGroup">
            <Setter Property="Width" Value="52" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="TextBlock.needsAPerson">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.fails, TextBlock.broken">
            <Setter Property="Foreground" Value="{StaticResource NotePage.WarningRed}" />
        </Style>
        <Style Selector="TextBlock.toReview">
            <Setter Property="Foreground" Value="{StaticResource NotePage.Italic}" />
        </Style>
        <!-- On the selected row's background, the colours above are hard to read. -->
        <Style Selector="DataGridRow:selected TextBlock.fails, DataGridRow:selected TextBlock.broken, DataGridRow:selected TextBlock.toReview">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="6">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6" MinHeight="20">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ProgressBar Grid.Column="1" Width="60" IsIndeterminate="True" IsVisible="{Binding IsComparing}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Refresh (F5)" Command="{Binding RefreshCommand}" Padding="8,2"
                    ToolTip.Tip="Parses every parsing case again, and lists those the filters let through now. Until then the cases listed stay listed, each kept up to date, even one the filters would no longer let through." />
        </Grid>

        <!-- The filters: by outcome, by verdict, and by text. -->
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Left" Classes="filterGroup" Text="Parses"
                       ToolTip.Tip="How the sentence parses now, compared with what its parsing case expects. With none picked, every outcome is listed." />
            <ItemsControl ItemsSource="{Binding ByOutcome.Filters}" ItemTemplate="{StaticResource FilterToggle}" ItemsPanel="{StaticResource FiltersInARow}" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Left" Classes="filterGroup" Text="Verdict"
                       ToolTip.Tip="What a person has found about the vocab the parsing case expects the breakdown to display. With none picked, every verdict is listed." />
            <ItemsControl ItemsSource="{Binding ByVerdict.Filters}" ItemTemplate="{StaticResource FilterToggle}" ItemsPanel="{StaticResource FiltersInARow}" />
        </DockPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding TextFilter}" PlaceholderText="Name, sentence or why contains..." Margin="0,0,0,6" />

        <!-- The selected case's why and its differences. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="1" BorderBrush="Gray" Padding="6" Margin="0,6,0,0"
                IsVisible="{Binding SelectedCase, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding SelectedCase}" x:DataType="parsingCases:ListedParsingCaseViewModel" Spacing="4">
                    <SelectableTextBlock Text="{Binding Why}" TextWrapping="Wrap" IsVisible="{Binding HasAWhy}" />
                    <TextBlock Text="It parses as its parsing case expects." IsVisible="{Binding !HasDifferences}" Opacity="0.7" />
                    <ItemsControl ItemsSource="{Binding Differences}" IsVisible="{Binding HasDifferences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource JapaneseFont}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- The columns are often too narrow for their text, so a text column shows a cell's whole text on hover. -->
        <DataGrid x:Name="CasesGrid" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase, Mode=TwoWay}">
            <DataGrid.Columns>
                <!-- Sorted by the outcome itself, those that fail first, rather than by its text. -->
                <DataGridTemplateColumn Header="Parses" SortMemberPath="Outcome" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="parsingCases:ListedParsingCaseViewModel">
                            <TextBlock Classes="cell" Classes.fails="{Binding Fails}" Classes.toReview="{Binding IsToReview}"
                                       Classes.needsAPerson="{Binding HasDifferences}" Text="{Binding OutcomeText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Verdict" SortMemberPath="Verdict" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="parsingCases:ListedParsingCaseViewModel">
                            <TextBlock Classes="cell" Classes.broken="{Binding IsBroken}" Classes.needsAPerson="{Binding IsBroken}" Text="{Binding VerdictText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <resultsViews:TextColumnShowingTheWholeTextOnHover Header="Name" Binding="{Binding Name}" Width="*" />
                <resultsViews:TextColumnShowingTheWholeTextOnHover Header="Sentence" Binding="{Binding Question}" Width="*" FontFamily="{StaticResource JapaneseFont}" FontSize="16" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</UserControl>
