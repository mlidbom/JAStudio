<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tagManagement="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation.TagManagement"
             x:Class="JAStudio.UI.Views.Workspace.Navigation.TagManagement.TagManagementView"
             x:DataType="tagManagement:TagManagementViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    </UserControl.KeyBindings>

    <DockPanel Margin="6">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBox x:Name="FilterBox" Grid.Column="0" Text="{Binding Filter}"
                     PlaceholderText="Filter: type parts of a tag path, such as nat s3" />
            <Button Grid.Column="1" Content="Refresh (F5)" Command="{Binding RefreshCommand}" Padding="8,2" Margin="6,0,0,0"
                    ToolTip.Tip="Counts the tags again. The tree shows the tags as they were when the tab was shown, until then." />
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Each tag shows how many notes are in its branch. Enter or a double-click searches for them, F2 renames, Del deletes. Down moves from the filter to the tree. Right-click for more." />

        <TreeView x:Name="TagTree" ItemsSource="{Binding TopLevelLines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="tagManagement:TagTreeNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="tagManagement:TagTreeNodeViewModel" ItemsSource="{Binding Children}">
                    <!-- The transparent background makes the space between the texts part of the line, for double-clicking. -->
                    <StackPanel Classes="TagLine" Orientation="Horizontal" Spacing="8" Background="Transparent" DoubleTapped="OnDoubleTappedOnALine">
                        <TextBlock Text="{Binding LastLevel}" />
                        <TextBlock Text="{Binding NumberOfNotesInTheBranch}" Foreground="Gray" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>

</UserControl>
