<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation"
             xmlns:search="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation.Search"
             xmlns:resultsViews="clr-namespace:JAStudio.UI.Views.Workspace.Navigation.SearchResults"
             x:Class="JAStudio.UI.Views.Workspace.Navigation.NoteSearchView"
             x:DataType="navigation:NoteSearchViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    </UserControl.KeyBindings>

    <DockPanel Margin="6">
        <TreeView x:Name="ConditionTree" DockPanel.Dock="Top" MaxHeight="300"
                  ItemsSource="{Binding Nodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="search:SearchConditionNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
                        <Button Content="+" Padding="6,0" IsVisible="{Binding IsGroup}"
                                ToolTip.Tip="Add a condition (+)"
                                Click="OnAddButtonClicked" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,6" MinHeight="20">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ProgressBar Grid.Column="1" Width="60" IsIndeterminate="True" IsVisible="{Binding IsSearching}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Refresh (F5)" Command="{Binding RefreshCommand}" Padding="8,2"
                    ToolTip.Tip="Runs the search again. Until then the results keep showing the same notes, kept up to date, even those the search would no longer find." />
        </Grid>

        <resultsViews:SearchResultsView DataContext="{Binding Results}" />
    </DockPanel>

</UserControl>
