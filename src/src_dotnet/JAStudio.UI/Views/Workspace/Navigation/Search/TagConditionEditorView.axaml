<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:search="clr-namespace:JAStudio.UI.ViewModels.Workspace.Navigation.Search"
             x:Class="JAStudio.UI.Views.Workspace.Navigation.Search.TagConditionEditorView"
             x:DataType="search:TagConditionEditorViewModel">

    <StackPanel Spacing="6">
        <TextBox x:Name="TypedPartsBox" Classes="initialFocus"
                 Text="{Binding TypedParts}"
                 PlaceholderText="Parts of the tag's path, such as nat s3 05" />
        <ListBox x:Name="MatchingTagPathsList" Height="240"
                 ItemsSource="{Binding MatchingTagPaths}"
                 SelectedItem="{Binding PickedTagPath}" />
    </StackPanel>

</UserControl>
