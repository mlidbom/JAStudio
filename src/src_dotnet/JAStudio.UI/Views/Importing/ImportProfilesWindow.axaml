<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:importing="clr-namespace:JAStudio.UI.ViewModels.Importing"
        x:Class="JAStudio.UI.Views.Importing.ImportProfilesWindow"
        x:DataType="importing:ImportProfilesWindowViewModel"
        Title="Import profiles"
        Width="1000"
        Height="620">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200,*" Margin="10">
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Import profiles" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <Button Content="New" Command="{Binding AddProfileCommand}" />
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="importing:ImportProfileEditorViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Content="Check" Command="{Binding CheckCommand}"
                        ToolTip.Tip="Opens the profile's import run window, which shows what a run would do with each raw note, and every problem that stops it." />
            </StackPanel>

            <ContentControl Content="{Binding SelectedProfile}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="importing:ImportProfileEditorViewModel">
                        <ScrollViewer>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Anki note type" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiNoteTypeChoices}" SelectedItem="{Binding AnkiNoteType}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Anki search" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AnkiSearch}" PlaceholderText="Optional: narrows the notes of the note type, such as deck:Natsume" />
                                </Grid>

                                <Grid ColumnDefinitions="5*,24,7*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="heading" Text="Each sentence field takes its value from" />
                                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Source question" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding SourceQuestion}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Source answer" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding SourceAnswer}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Reading" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding Reading}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="External id" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding ExternalId}" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Source comments" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding SourceComments}" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Audio" />
                                            <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding Audio}" />
                                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Screenshot" />
                                            <ComboBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnkiFieldChoices}" SelectedItem="{Binding Screenshot}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="heading" Text="The media goes into these folders of the media layer" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Audio folder" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AudioFolder}" PlaceholderText="Inside free/ or a commercial repository"
                                                     ToolTip.Tip="Inside free/ or a commercial repository, such as commercial-01/anime/immersion-kit/audio" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Screenshot folder" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScreenshotFolder}" PlaceholderText="Inside free/ or a commercial repository"
                                                     ToolTip.Tip="Inside free/ or a commercial repository, such as commercial-01/anime/immersion-kit/screenshots" />
                                        </Grid>

                                        <TextBlock Classes="heading" Text="Tags" />
                                        <TextBox Text="{Binding TagsToAdd}" PlaceholderText="Besides the raw note's own, separated by spaces"
                                                 ToolTip.Tip="Tags each sentence gets besides the raw note's own, separated by spaces, such as source::immersion_kit" />

                                        <TextBlock Classes="heading" Text="After a run" />
                                        <CheckBox IsChecked="{Binding DeletesTheRawNotesAfterwards}">
                                            <TextBlock TextWrapping="Wrap" Text="Delete the raw notes from Anki. Otherwise they're tagged jastudio::imported, which later runs leave out." />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding CreatesAnkiNotesToStudy}">
                                            <TextBlock TextWrapping="Wrap" Text="Give each sentence a note in this Anki profile to study. Otherwise it's added to the corpus only." />
                                        </CheckBox>

                                        <TextBlock Classes="heading" Text="When it runs" />
                                        <CheckBox IsChecked="{Binding RunsAutomatically}">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Automatically, when Anki finishes importing a file or a note of the note type is added. A run with problems opens its import run window instead." />
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </DockPanel>
    </Grid>

</Window>
