<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <!-- Copy NuGet assemblies (Avalonia, Skia) to output folder -->
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
      <!-- Include native libraries for current platform -->
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifier>
      <SelfContained>false</SelfContained>
      <DebugType>portable</DebugType>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.1.5" />
      <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
      <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
      <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="MessageBox.Avalonia" Version="12.1.0" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\JAStudio.Anki\JAStudio.Anki.csproj" />
      <ProjectReference Include="..\JAStudio.Core\JAStudio.Core.csproj" />
      <ProjectReference Include="..\JAStudio.TextToSpeech\JAStudio.TextToSpeech.csproj" />
      <ProjectReference Include="..\JAStudio.Audio\JAStudio.Audio.csproj" />
   </ItemGroup>

   <ItemGroup>
      <!-- rationale: the specifications drive the workspace through its view models, which are internal. In JAStudio, public
           means reachable from Python, whose stubs cover every public type, so making them public would widen the Python layer.
           See dev_docs/code_standard_exceptions/the-ui-specifications-see-the-uis-internals.md -->
      <InternalsVisibleTo Include="JAStudio.UI.Specifications" />
      <InternalsVisibleTo Include="JAStudio.UI.Views.Specifications" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="Compze.Underscore" Version="0.6.0-beta" />
      <PackageReference Include="Compze.Internals.Logging" Version="0.6.0-alpha" />
      <PackageReference Include="Compze.Internals.SystemCE" Version="0.6.1-internal" />
   </ItemGroup>

</Project>
