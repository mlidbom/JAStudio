<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:JAStudio.UI.Controls"
             x:Class="JAStudio.UI.Controls.StringSetControl"
             x:DataType="local:StringSetControlViewModel">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewValue, Mode=TwoWay}" PlaceholderText="Type a string to add">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:StringChipViewModel">
                    <Border Background="#e0e0e0" CornerRadius="3" Padding="6,3" Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" />
                            <Button Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove"
                                    Width="16" Height="16" Padding="0" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
