<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:relatedWords="clr-namespace:JAStudio.UI.Controls.NoteFields.RelatedWords"
             x:Class="JAStudio.UI.Controls.NoteFields.RelatedWords.WordSetEditor"
             x:DataType="relatedWords:WordSetEditorViewModel">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Create and add" Command="{Binding CreateAndAddCommand}" IsVisible="{Binding OffersToCreateTheVocab}"
                    Margin="6,0,0,0" ToolTip.Tip="No vocab has this word: create its vocab, from the dictionary when it has the word, add it, and open it for editing" />
            <AutoCompleteBox x:Name="WordBox" ItemsSource="{Binding Pickable}" Text="{Binding NewWord, Mode=TwoWay}"
                             ValueMemberBinding="{Binding Name, x:DataType=relatedWords:PickableVocab}"
                             FilterMode="Custom" MinimumPrefixLength="1" MaxDropDownHeight="300"
                             PlaceholderText="Type a word, or its reading, to find its vocab">
                <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="relatedWords:PickableVocab">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Answer}" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        </StackPanel>
                    </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
                <AutoCompleteBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </AutoCompleteBox.KeyBindings>
            </AutoCompleteBox>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="relatedWords:WordChipViewModel">
                    <Border Background="#e0e0e0" CornerRadius="3" Padding="6,3" Margin="2" ToolTip.Tip="{Binding WhyDimmed}"
                            Opacity="{Binding RefersToAVocab, Converter={x:Static relatedWords:WordSetEditor.OpacityOfAChip}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <Button Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove"
                                    Width="16" Height="16" Padding="0" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
