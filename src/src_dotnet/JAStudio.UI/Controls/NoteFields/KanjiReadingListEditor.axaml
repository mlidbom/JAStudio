<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:noteFields="clr-namespace:JAStudio.UI.Controls.NoteFields"
             x:Class="JAStudio.UI.Controls.NoteFields.KanjiReadingListEditor"
             x:DataType="noteFields:KanjiReadingListEditorViewModel">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Label}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewReading, Mode=TwoWay}" PlaceholderText="Type a reading to add">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="noteFields:KanjiReadingChipViewModel">
                    <Border Background="#e0e0e0" CornerRadius="3" Padding="6,3" Margin="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Kana}" VerticalAlignment="Center" />
                            <CheckBox Content="primary" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center"
                                      ToolTip.Tip="A primary reading is one the kanji is studied by: its default mnemonic is made of them, and its page highlights them in its vocab's readings" />
                            <Button Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove"
                                    Width="16" Height="16" Padding="0" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
