<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:taskRunners="clr-namespace:JAStudio.Core.TaskRunners;assembly=JAStudio.Core"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="80"
             x:Class="JAStudio.UI.Dialogs.BatchTaskProgressPanel"
             x:DataType="taskRunners:BatchTaskProgressViewModel">

    <StackPanel Margin="0,2" Spacing="1">
        <!-- Message + stats on same line -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatsText}"
                       FontSize="11"
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
            <TextBlock Text="{Binding Message}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"/>
        </DockPanel>

        <!-- Determinate Progress Bar + Cancel Button -->
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    Padding="8,2"
                    Margin="6,0,0,0"
                    FontSize="11"
                    VerticalAlignment="Center"
                    Click="OnCancelClick"
                    IsVisible="{Binding IsCancelVisible}"/>
            <ProgressBar Height="14"
                         IsIndeterminate="False"
                         Minimum="0"
                         Maximum="{Binding Total}"
                         Value="{Binding Current}"
                         VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</UserControl>
