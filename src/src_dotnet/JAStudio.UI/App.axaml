<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:matching="clr-namespace:JAStudio.UI.ViewModels.Workspace.Editors.Matching"
             xmlns:sentencePages="clr-namespace:JAStudio.UI.ViewModels.Workspace.NotePages.Sentences"
             xmlns:notePageViews="clr-namespace:JAStudio.UI.Views.Workspace.NotePages"
             x:Class="JAStudio.UI.UIApp"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- Japanese text: Windows', macOS's and Linux's Japanese fonts, then Windows' Chinese one, which has the kanji too. Fonts that aren't installed are skipped. -->
        <FontFamily x:Key="JapaneseFont">Meiryo UI,Yu Gothic UI,Hiragino Sans,Noto Sans CJK JP,Microsoft YaHei UI</FontFamily>
        <!-- Code, such as a vocab's match-condition in its tree editor: monospace, with the Japanese fonts for the Japanese in it. -->
        <FontFamily x:Key="CodeFont">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Meiryo UI,Yu Gothic UI,Hiragino Sans,Noto Sans CJK JP,monospace</FontFamily>
        <!-- A line of a condition's code, in pieces each shown as its kind should be (the TextBlock.code styles below): a line of the tree editor, or of a
             condition's code shown read-only. A shared-condition's name shows its definition on hover. -->
        <DataTemplate x:Key="CodeLine" DataType="matching:CodeLineViewModel">
            <ItemsControl ItemsSource="{Binding Pieces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="matching:CodePieceViewModel">
                        <!-- A transparent background, so that a click anywhere on the piece reaches it, as Ctrl+click on a shared-condition's name does. -->
                        <TextBlock Classes="code" Text="{Binding Text}" Background="Transparent"
                                   Classes.negation="{Binding IsNegation}" Classes.comment="{Binding IsComment}"
                                   Classes.sharedConditionName="{Binding IsSharedConditionName}"
                                   ToolTip.ServiceEnabled="{Binding IsSharedConditionName}">
                            <ToolTip.Tip>
                                <TextBlock Text="{Binding SharedConditionAsDefined}" FontFamily="{StaticResource CodeFont}" />
                            </ToolTip.Tip>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <!-- The note pages' colours: the cards' light colours, as the cards' stylesheets define them (JAStudio.Web/Styles/_010_colors.scss and the
             notes' own), their colour mixes computed. Code that styles text reads them through NotePageBrushes. -->
        <SolidColorBrush x:Key="NotePage.Background" Color="#D8C5A3" />
        <!-- Behind a breakdown's entries, the user's own texts and a kanji's mnemonic: the cards' colorBgOffset1. -->
        <SolidColorBrush x:Key="NotePage.EntryBackground" Color="#CEBC9C" />
        <SolidColorBrush x:Key="NotePage.CompoundPartBackground" Color="#C0B092" />
        <SolidColorBrush x:Key="NotePage.AlternateRowBackground" Color="#D3C09F" />
        <SolidColorBrush x:Key="NotePage.Text" Color="#3D3931" />
        <SolidColorBrush x:Key="NotePage.Question" Color="#322F28" />
        <SolidColorBrush x:Key="NotePage.SectionBorder" Color="#A99A80" />
        <SolidColorBrush x:Key="NotePage.SectionTitle" Color="#726F69" />
        <SolidColorBrush x:Key="NotePage.UserCommentsBorder" Color="#C98A58" />
        <SolidColorBrush x:Key="NotePage.Green" Color="#47803B" />
        <SolidColorBrush x:Key="NotePage.Underline" Color="#A79EE2" />
        <SolidColorBrush x:Key="NotePage.Bold" Color="#BD422B" />
        <SolidColorBrush x:Key="NotePage.WarningRed" Color="#C81707" />
        <SolidColorBrush x:Key="NotePage.Meaning" Color="#974870" />
        <SolidColorBrush x:Key="NotePage.Italic" Color="#AC6B1A" />
        <SolidColorBrush x:Key="NotePage.Reading" Color="#AC6B1A" />
        <SolidColorBrush x:Key="NotePage.ReadingsSeparator" Color="#A9A9A9" />
        <SolidColorBrush x:Key="NotePage.RadicalBackground" Color="#7CBCF6" />
        <SolidColorBrush x:Key="NotePage.KanjiBackground" Color="#FFA0CF" />
        <SolidColorBrush x:Key="NotePage.VocabularyBackground" Color="#D896FA" />
        <SolidColorBrush x:Key="NotePage.ReadingBackground" Color="#E1A360" />
        <SolidColorBrush x:Key="NotePage.PlayButton" Color="#1D4ED8" />
    </Application.Resources>
    <!-- The views of the notes' pages in Avalonia, which a workspace tab shows (NotePagePresenter). -->
    <Application.DataTemplates>
        <DataTemplate DataType="sentencePages:SentencePageViewModel">
            <notePageViews:SentencePageView />
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- The pieces of a condition's code (the CodeLine template above). -->
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
        </Style>
        <!-- A ! at the start of a line is easy to miss. -->
        <Style Selector="TextBlock.code.negation">
            <Setter Property="Foreground" Value="#E8590C" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.code.comment">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- A shared-condition's name stands for a definition of the corpus's, as an IDE colors the methods you wrote. -->
        <Style Selector="TextBlock.code.sharedConditionName">
            <Setter Property="Foreground" Value="#2E8BC0" />
        </Style>
    </Application.Styles>
</Application>
