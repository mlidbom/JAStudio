<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows reads this manifest; other systems ignore it. Without the supported OS below, Avalonia can't create the native child window that hosts
       a page's web view (NativeControlHost): "Unable to create child window for native control host. Application manifest with supported OS list might
       be required." Inside Anki, Anki's own executable has such a manifest. -->
  <assemblyIdentity version="1.0.0.0" name="JAStudio.StandaloneHost"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
