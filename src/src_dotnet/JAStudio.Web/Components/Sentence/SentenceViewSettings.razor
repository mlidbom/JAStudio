@using JAStudio.Core.Configuration
@using JAStudio.Core.UI.Web.Sentence

<span class="view_settings">
    <span class="view_settings_title">Settings:</span>
    @foreach(var toggle in SentenceViewToggleViewModel.TheOnesOnIn(Config))
    {
        <span class="toggle @toggle.Name" title="@toggle.Title">@toggle.Abbreviation</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public JapaneseConfig Config { get; set; } = null!;
}
