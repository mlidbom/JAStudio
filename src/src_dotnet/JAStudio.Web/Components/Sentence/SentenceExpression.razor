@using JAStudio.Core.Configuration
@using JAStudio.Core.Note.NoteFields
@using JAStudio.Core.Note.Sentences

@* The sentence's audio button stands in front of the first question shown: the user's question if there is one, else the source question. *@
<div id="expressionAndReading">
    @if(HasUserQuestion)
    {
        <div class="expression user"><AudioPlayButton Audio="Note.PreferredAudio" IsAudioOfTheShownNote="true" /><span class="clipboard">@((MarkupString)RenderWbr(Note.User.Question.Value))</span></div>
    }
    <div class="expression @(HasUserQuestion ? "overridden" : "")"><AudioPlayButton Audio="@(HasUserQuestion ? null : Note.PreferredAudio)" IsAudioOfTheShownNote="true" /><span class="clipboard">@((MarkupString)RenderWbr(Note.SourceQuestion.Value))</span></div>
    <div class="reading">@((MarkupString)Note.Reading.Value)</div>
</div>

@code {
    [Parameter, EditorRequired] public SentenceNote Note { get; set; } = null!;
    [Parameter, EditorRequired] public JapaneseConfig Config { get; set; } = null!;

    bool HasUserQuestion => !string.IsNullOrEmpty(Note.User.Question.Value);

    string RenderWbr(string question) =>
        Config.ShowSentenceBreakdownInEditMode.Value
            ? question.Replace(SentenceQuestionField.WordBreakTag, "<span class='wbr_tag'>&lt;wbr&gt;</span>")
            : question;
}
