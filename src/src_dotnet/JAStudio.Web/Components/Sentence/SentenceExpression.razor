@using JAStudio.Core.Configuration
@using JAStudio.Core.Note.NoteFields
@using JAStudio.Core.Note.Sentences

@* The sentence's audio button stands in front of the first question shown: the corpus's question if there is one, else the source's. *@
<div id="expressionAndReading">
    @if(HasCorpusQuestion)
    {
        <div class="expression user"><AudioPlayButton Audio="Note.PreferredAudio" IsAudioOfTheShownNote="true" /><span class="clipboard">@((MarkupString)RenderWbr(Note.CorpusQuestion.Value))</span></div>
    }
    <div class="expression @(HasCorpusQuestion ? "overridden" : "")"><AudioPlayButton Audio="@(HasCorpusQuestion ? null : Note.PreferredAudio)" IsAudioOfTheShownNote="true" /><span class="clipboard">@((MarkupString)RenderWbr(Note.SourceData.Question.Value))</span></div>
    <div class="reading">@((MarkupString)Note.Reading.Value)</div>
</div>

@code {
    [Parameter, EditorRequired] public SentenceNote Note { get; set; } = null!;
    [Parameter, EditorRequired] public JapaneseConfig Config { get; set; } = null!;

    bool HasCorpusQuestion => Note.CorpusQuestion.HasValue();

    string RenderWbr(string question) =>
        Config.ShowSentenceBreakdownInEditMode.Value
            ? question.Replace(SentenceQuestionField.WordBreakTag, "<span class='wbr_tag'>&lt;wbr&gt;</span>")
            : question;
}
