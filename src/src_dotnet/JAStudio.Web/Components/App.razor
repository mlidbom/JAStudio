@using Microsoft.AspNetCore.Components.Web
@inject WebRootFiles Files

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>JAStudio</title>
    <link rel="stylesheet" href="@Files.VersionedPath("/css/vocab-card.css")" />
    <link rel="stylesheet" href="@Files.VersionedPath("/css/kanji-card.css")" />
    <link rel="stylesheet" href="@Files.VersionedPath("/css/sentence-card.css")" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    @* ReSharper disable Html.PathError *@
    <script src="/_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    @* ReSharper restore Html.PathError *@
    <script src="@Files.VersionedPath("/js/card.js")"></script>
</body>
</html>
