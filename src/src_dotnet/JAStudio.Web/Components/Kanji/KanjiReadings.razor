@using JAStudio.Core.Note
@using JAStudio.Core.Note.KanjiReadings
@using JAStudio.Core.ViewModels

<span class="reading">@((MarkupString)OnReadings)</span> <span class="readingsSeparator">|</span>
<span class="reading">@((MarkupString)KunReadings)</span> <span class="readingsSeparator">|</span>
<span class="reading">@((MarkupString)NanoriReadings)</span>

@code {
    [Parameter, EditorRequired] public KanjiNote Note { get; set; } = null!;

    string OnReadings => EachCopyable(Note.Readings.On);

    string KunReadings => EachCopyable(Note.Readings.Kun);

    string NanoriReadings => EachCopyable(Note.Readings.Nanori);

    static string EachCopyable(KanjiReadingList readings) => string.Join(", ",
        KanjiReadingsHtml.Of(readings)
            .Select(r => $"""<span class="clipboard">{r}</span>"""));
}
