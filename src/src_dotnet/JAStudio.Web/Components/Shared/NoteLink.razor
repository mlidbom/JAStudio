@using JAStudio.Core.Note

<a class="note-link" href="@CardServerUrl.NotePagePath(Note)" data-note-type="@CardServerUrl.CardPageNoteType(Note)" data-note-id="@Note.GetId()" draggable="false">@ChildContent</a>

@code {
    [Parameter, EditorRequired] public JPNote Note { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
}
