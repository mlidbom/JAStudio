<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <OutputType>Exe</OutputType>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <!-- The MCP gateway copies this build output each time it starts the headless JAStudio: keep it small. -->
      <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifier>
      <SelfContained>false</SelfContained>
      <!-- The garbage collector in server mode, with DATAS off, as in Anki: parsing on many threads allocates fast. See dev_docs/parsing-speed.md. -->
      <ServerGarbageCollection>true</ServerGarbageCollection>
      <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
   </PropertyGroup>

   <ItemGroup>
      <ProjectReference Include="..\JAStudio.Anki\JAStudio.Anki.csproj" />
      <ProjectReference Include="..\JAStudio.Mcp\JAStudio.Mcp.csproj" />
      <ProjectReference Include="..\JAStudio.Web\JAStudio.Web.csproj" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="Compze.DependencyInjection" Version="0.9.0-alpha" />
      <PackageReference Include="Compze.DependencyInjection.Microsoft" Version="0.6.0-alpha" />
      <PackageReference Include="Compze.DependencyInjection.Microsoft.Extensions.Hosting" Version="0.5.0-alpha" />
      <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
   </ItemGroup>

</Project>
