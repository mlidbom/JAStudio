<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <!-- Copy NuGet assemblies to the output folder: Anki's add-on copies JAStudio's runtime from it (copy_runtime_binaries.py), and the MCP server's (ModelContextProtocol) are in no other output it copies from -->
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
   </PropertyGroup>

   <ItemGroup>
      <ProjectReference Include="..\JAStudio.Core\JAStudio.Core.csproj" />
      <ProjectReference Include="..\JAStudio.Anki\JAStudio.Anki.csproj" />
      <ProjectReference Include="..\JAStudio.PythonInterop\JAStudio.PythonInterop.csproj" />
      <ProjectReference Include="..\JAStudio.UI\JAStudio.UI.csproj" />
      <ProjectReference Include="..\JAStudio.Web\JAStudio.Web.csproj" />
      <ProjectReference Include="..\JAStudio.Mcp\JAStudio.Mcp.csproj" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="Avalonia" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="Compze.Internals.Logging" />
      <PackageReference Include="Compze.Internals.SystemCE" />
      <PackageReference Include="Compze.DependencyInjection" />
      <PackageReference Include="Compze.DependencyInjection.Microsoft" />
      <PackageReference Include="Compze.DependencyInjection.Microsoft.Extensions.Hosting" />
   </ItemGroup>

</Project>
