<Project Sdk="Microsoft.NET.Sdk">

   <!--
   Specifications of the windows themselves, which JAStudio.UI.Specifications doesn't open: it drives the view models.
   They run on Avalonia's headless platform, which takes over the UI thread dispatcher of the process. JAStudio.UI.Specifications
   relies on the dispatcher running what's posted to it at once, so the two can't share a process.
   -->
   <PropertyGroup>
      <PlatformTarget>x64</PlatformTarget>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <IsPackable>false</IsPackable>
      <!-- Include native libraries for current platform -->
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
      <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifier>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
         <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
         <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
   </ItemGroup>

   <ItemGroup>
      <Using Include="Xunit"/>
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\JAStudio.UI\JAStudio.UI.csproj"/>
      <!-- For SpecificationStartingWithAnEmptyCollection: the application's real services with an empty collection. -->
      <ProjectReference Include="..\JAStudio.Core.Specifications\JAStudio.Core.Specifications.csproj"/>
   </ItemGroup>

</Project>
