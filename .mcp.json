{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "jastudio": {
      "type": "stdio",
      "command": "pwsh",
      "args": ["-NoProfile", "-NonInteractive", "-File", "src/src_dotnet/JAStudio.Mcp.Gateway/start-the-gateway.ps1"]
    },
    "jetbrains-rider": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:64482/stream"
    },
	"jetbrains-pycharm": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:64462/stream"
    },
    "resharper-joshua": {
      "type": "http",
      "url": "http://127.0.0.1:23741/"
    },
    "sherlock": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "sherlock-mcp"],
      "env": {}
    },
    "windows-mcp": {
      "type": "stdio",
      "command": "windows-mcp",
      "args": ["serve", "--transport", "stdio"],
      "env": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}
