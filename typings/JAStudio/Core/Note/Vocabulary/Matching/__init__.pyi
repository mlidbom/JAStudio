import typing
from JAStudio.Core.Note.NoteFields import FlagField
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Grouping import AllOfGroup_1
from JAStudio.Core.LanguageServices.Parsing.WordExtraction import CandidateWordVariant
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Rules import MatchingRule, RequireForbidMatchingRule
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Sharing import ISharedCondition
from System.Collections.Generic import IReadOnlySet_1

class IsInflectingWord(FlagField):
    @property
    def IsActive(self) -> bool: ...
    @property
    def Name(self) -> str: ...
    def ToString(self) -> str: ...


class RequireForbidChoice(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    Unset : RequireForbidChoice # 0
    Required : RequireForbidChoice # 1
    Forbidden : RequireForbidChoice # 2


class RequireForbidFlagField:
    @property
    def Choice(self) -> RequireForbidChoice: ...
    @Choice.setter
    def Choice(self, value: RequireForbidChoice) -> RequireForbidChoice: ...
    @property
    def ForbiddenWeight(self) -> int: ...
    @property
    def IsConfigured(self) -> bool: ...
    @property
    def IsForbidden(self) -> bool: ...
    @property
    def IsRequired(self) -> bool: ...
    @property
    def MatchWeight(self) -> int: ...
    @property
    def Name(self) -> str: ...
    @property
    def RequiredWeight(self) -> int: ...
    def Choose(self, choice: RequireForbidChoice) -> None: ...
    def ToString(self) -> str: ...


class VocabMatchingFlags:
    @property
    def IsCompositionallyTransparentCompound(self) -> FlagField: ...
    @property
    def IsInflectingWord(self) -> IsInflectingWord: ...
    @property
    def IsPoisonWord(self) -> FlagField: ...
    @property
    def MatchWithPrecedingVowel(self) -> FlagField: ...
    @property
    def QuestionOverridesForm(self) -> FlagField: ...


class VocabMatchingRequireForbidFlags:
    @property
    def DictionaryFormStart(self) -> RequireForbidFlagField: ...
    @property
    def MatchWeight(self) -> int: ...
    @property
    def YieldLastToken(self) -> YieldLastTokenToOverlappingCompound: ...


class VocabNoteMatchingConfiguration:
    @property
    def CustomRequirementsWeight(self) -> int: ...
    @property
    def Flags(self) -> VocabMatchingFlags: ...
    @property
    def MatchCondition(self) -> AllOfGroup_1[CandidateWordVariant]: ...
    @MatchCondition.setter
    def MatchCondition(self, value: AllOfGroup_1[CandidateWordVariant]) -> AllOfGroup_1[CandidateWordVariant]: ...
    @property
    def RequiresForbids(self) -> VocabMatchingRequireForbidFlags: ...
    @property
    def YieldToSurface(self) -> VocabYieldToSurface: ...
    def MatchConditionHolds(self, rule: MatchingRule) -> bool: ...
    def MatchConditionRequires(self, rule: RequireForbidMatchingRule) -> bool: ...
    def SetMatchCondition(self, matchCondition: AllOfGroup_1[CandidateWordVariant]) -> None: ...
    def UseWhereverItsDefinitionIs(self, sharedCondition: ISharedCondition) -> None: ...


class VocabYieldToSurface:
    @property
    def Surfaces(self) -> IReadOnlySet_1[str]: ...
    def Add(self, surface: str) -> None: ...
    def Remove(self, surface: str) -> None: ...


class YieldLastTokenToOverlappingCompound(RequireForbidFlagField):
    @property
    def Choice(self) -> RequireForbidChoice: ...
    @property
    def ForbiddenWeight(self) -> int: ...
    @property
    def IsConfigured(self) -> bool: ...
    @property
    def IsForbidden(self) -> bool: ...
    @property
    def IsRequired(self) -> bool: ...
    @property
    def MatchWeight(self) -> int: ...
    @property
    def Name(self) -> str: ...
    @property
    def RequiredWeight(self) -> int: ...
    def ToString(self) -> str: ...

