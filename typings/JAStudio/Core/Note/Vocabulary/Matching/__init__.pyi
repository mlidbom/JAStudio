class IsInflectingWord(FlagField):
    @property
    def IsActive(self) -> bool: ...
    @property
    def Name(self) -> str: ...
    def ToString(self) -> str: ...


class RequireForbidChoice(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    Unset : RequireForbidChoice # 0
    Required : RequireForbidChoice # 1
    Forbidden : RequireForbidChoice # 2


class RequireForbidFlagField:
    @property
    def Choice(self) -> RequireForbidChoice: ...
    @Choice.setter
    def Choice(self, value: RequireForbidChoice) -> RequireForbidChoice: ...
    @property
    def ForbiddenWeight(self) -> int: ...
    @property
    def IsConfigured(self) -> bool: ...
    @property
    def IsForbidden(self) -> bool: ...
    @property
    def IsRequired(self) -> bool: ...
    @property
    def MatchWeight(self) -> int: ...
    @property
    def Name(self) -> str: ...
    @property
    def RequiredWeight(self) -> int: ...
    def Choose(self, choice: RequireForbidChoice) -> None: ...
    def ToString(self) -> str: ...


