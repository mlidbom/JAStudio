import typing, abc
from JAStudio.Core.Note.Vocabulary.Matching.Conditions import Condition, IConditionLevel
from JAStudio.Core.Note.ConditionTrees import ConditionPosition
from System.Collections.Generic import IReadOnlyList_1
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Sharing import ConditionWithItsLevel, ISharedCondition, SharedConditions
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Code import CodeLine
from System import Func_1
from JAStudio.Core.Note.Vocabulary import VocabNote
from JAStudio.Core.Note.Vocabulary.Matching.Conditions.Checking import CheckedCondition
from JAStudio.Core.LanguageServices.Parsing.WordExtraction import CandidateWordVariant

class EditableCondition:
    def __init__(self, tree: Condition, level: IConditionLevel) -> None: ...
    @property
    def CanUndo(self) -> bool: ...
    @property
    def Current(self) -> Condition: ...
    @Current.setter
    def Current(self, value: Condition) -> Condition: ...
    @property
    def Level(self) -> IConditionLevel: ...
    def AddCondition(self, groupPosition: ConditionPosition, condition: Condition) -> ConditionPosition: ...
    def ChangedElsewhere(self, tree: Condition) -> None: ...
    def ConditionsToMakeASharedConditionOfAt(self, position: ConditionPosition) -> IReadOnlyList_1[ConditionWithItsLevel]: ...
    def LevelAt(self, position: ConditionPosition) -> IConditionLevel: ...
    def RemoveCondition(self, position: ConditionPosition) -> None: ...
    def ReplaceCondition(self, position: ConditionPosition, replacement: Condition) -> None: ...
    def SwitchGroup(self, groupPosition: ConditionPosition) -> None: ...
    def ToggleNegation(self, position: ConditionPosition) -> None: ...
    def Undo(self) -> None: ...


class EditedDefinition(IEditedCondition):
    def __init__(self, sharedCondition: ISharedCondition, sharedConditions: SharedConditions) -> None: ...
    @property
    def Level(self) -> IConditionLevel: ...
    @property
    def SharedCondition(self) -> ISharedCondition: ...
    @property
    def Stored(self) -> Condition: ...
    def LinesOf(self, tree: Condition) -> IReadOnlyList_1[CodeLine]: ...
    def SharedConditionsOfferedOn(self, level: IConditionLevel) -> IReadOnlyList_1[ISharedCondition]: ...
    def Store(self, tree: Condition) -> None: ...


class EditedMatchCondition(IEditedCondition):
    def __init__(self, currentVocab: Func_1[VocabNote]) -> None: ...
    @property
    def Level(self) -> IConditionLevel: ...
    @property
    def Stored(self) -> Condition: ...
    @staticmethod
    def CheckedAgainst(tree: Condition, word: CandidateWordVariant) -> CheckedCondition: ...
    def LinesOf(self, tree: Condition) -> IReadOnlyList_1[CodeLine]: ...
    def SharedConditionsOfferedOn(self, level: IConditionLevel) -> IReadOnlyList_1[ISharedCondition]: ...
    def Store(self, tree: Condition) -> None: ...


class IEditedCondition(typing.Protocol):
    @property
    def Level(self) -> IConditionLevel: ...
    @property
    def Stored(self) -> Condition: ...
    @abc.abstractmethod
    def LinesOf(self, tree: Condition) -> IReadOnlyList_1[CodeLine]: ...
    @abc.abstractmethod
    def SharedConditionsOfferedOn(self, level: IConditionLevel) -> IReadOnlyList_1[ISharedCondition]: ...
    @abc.abstractmethod
    def Store(self, tree: Condition) -> None: ...

