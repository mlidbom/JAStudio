    def LinesOf(condition: Condition) -> IReadOnlyList_1[CodeLine]: ...
    @staticmethod
    def LinesOfAMatchCondition(matchCondition: AllOfGroup_1[CandidateWordVariant]) -> IReadOnlyList_1[CodeLine]: ...
    @staticmethod
    def OnOneLine(condition: Condition) -> str: ...

