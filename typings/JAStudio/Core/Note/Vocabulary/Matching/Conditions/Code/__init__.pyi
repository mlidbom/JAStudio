class CodeLine:
    @property
    def Code(self) -> str: ...
    @property
    def Depth(self) -> int: ...
    @property
    def Position(self) -> ConditionPosition: ...
    @property
    def Texts(self) -> IReadOnlyList_1[CodeText]: ...
    def ToString(self) -> str: ...


class CodeText(IEquatable_1[CodeText]):
    def __init__(self, Text: str, Kind: CodeTextKind) -> None: ...
    @property
    def Kind(self) -> CodeTextKind: ...
    @Kind.setter
    def Kind(self, value: CodeTextKind) -> CodeTextKind: ...
    @property
    def Text(self) -> str: ...
    @Text.setter
    def Text(self, value: str) -> str: ...
    def Deconstruct(self, Text: clr.Reference[str], Kind: clr.Reference[CodeTextKind]) -> None: ...
    def GetHashCode(self) -> int: ...
    def __eq__(self, left: CodeText, right: CodeText) -> bool: ...
    def __ne__(self, left: CodeText, right: CodeText) -> bool: ...
    def ToString(self) -> str: ...
    # Skipped Equals due to it being static, abstract and generic.

    Equals : Equals_MethodGroup
    class Equals_MethodGroup:
        @typing.overload
        def __call__(self, other: CodeText) -> bool:...
        @typing.overload
        def __call__(self, obj: typing.Any) -> bool:...



class CodeTextKind(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    Code : CodeTextKind # 0
    Negation : CodeTextKind # 1
    Comment : CodeTextKind # 2


class ConditionCode(abc.ABC):
    MatchConditionHeading : str
    @staticmethod
    def AsText(lines: IReadOnlyList_1[CodeLine]) -> str: ...
