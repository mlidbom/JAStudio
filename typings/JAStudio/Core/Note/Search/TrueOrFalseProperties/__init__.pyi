import typing
from JAStudio.Core.Note.Search import NoteCondition, NoteProperty
from System import IEquatable_1
from System.Collections.Generic import IReadOnlyList_1, IEnumerable_1
from JAStudio.Core.Note import JPNote

class TrueOrFalseCondition(NoteCondition, IEquatable_1[TrueOrFalseCondition]):
    @property
    def Children(self) -> IReadOnlyList_1[NoteCondition]: ...
    @property
    def IsEmpty(self) -> bool: ...
    @property
    def Property(self) -> TrueOrFalseProperty: ...
    @property
    def Value(self) -> bool: ...
    def DescriptionLines(self) -> IEnumerable_1[str]: ...
    def GetHashCode(self) -> int: ...
    def Matches(self, note: JPNote) -> bool: ...
    def __eq__(self, left: TrueOrFalseCondition, right: TrueOrFalseCondition) -> bool: ...
    def __ne__(self, left: TrueOrFalseCondition, right: TrueOrFalseCondition) -> bool: ...
    # Skipped Equals due to it being static, abstract and generic.

    Equals : Equals_MethodGroup
    class Equals_MethodGroup:
        @typing.overload
        def __call__(self, other: TrueOrFalseCondition) -> bool:...
        @typing.overload
        def __call__(self, other: NoteCondition) -> bool:...
        @typing.overload
        def __call__(self, obj: typing.Any) -> bool:...



class TrueOrFalseProperty(NoteProperty):
    @property
    def Name(self) -> str: ...
    def Is(self, value: bool) -> TrueOrFalseCondition: ...

