import typing
from JAStudio.Core.Note.Search import NoteCondition, NoteProperty
from System import IEquatable_1
from System.Collections.Generic import IEnumerable_1
from JAStudio.Core.Note import JPNote

class TagCondition(NoteCondition, IEquatable_1[TagCondition]):
    @property
    def IsEmpty(self) -> bool: ...
    @property
    def Property(self) -> TagsProperty: ...
    @property
    def TagPath(self) -> str: ...
    def DescriptionLines(self) -> IEnumerable_1[str]: ...
    def GetHashCode(self) -> int: ...
    def Matches(self, note: JPNote) -> bool: ...
    def __eq__(self, left: TagCondition, right: TagCondition) -> bool: ...
    def __ne__(self, left: TagCondition, right: TagCondition) -> bool: ...
    # Skipped Equals due to it being static, abstract and generic.

    Equals : Equals_MethodGroup
    class Equals_MethodGroup:
        @typing.overload
        def __call__(self, other: TagCondition) -> bool:...
        @typing.overload
        def __call__(self, other: NoteCondition) -> bool:...
        @typing.overload
        def __call__(self, obj: typing.Any) -> bool:...



class TagsProperty(NoteProperty):
    @property
    def Name(self) -> str: ...
    def Include(self, tagPath: str) -> TagCondition: ...

