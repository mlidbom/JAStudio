from JAStudio.Core.Note.Search import NoteCondition
from JAStudio.Core.Note.ConditionTrees import ConditionPosition

class EditableSearch:
    def __init__(self) -> None: ...
    @property
    def CanUndo(self) -> bool: ...
    @property
    def Current(self) -> NoteCondition: ...
    @Current.setter
    def Current(self, value: NoteCondition) -> NoteCondition: ...
    def AddCondition(self, groupPosition: ConditionPosition, condition: NoteCondition) -> ConditionPosition: ...
    def RemoveCondition(self, position: ConditionPosition) -> None: ...
    def ReplaceCondition(self, position: ConditionPosition, replacement: NoteCondition) -> None: ...
    def ReplaceTheWholeSearchWith(self, condition: NoteCondition) -> ConditionPosition: ...
    def StartFrom(self, search: NoteCondition) -> None: ...
    def SwitchGroup(self, groupPosition: ConditionPosition) -> None: ...
    def ToggleNegation(self, position: ConditionPosition) -> None: ...
    def Undo(self) -> None: ...

