import typing, abc
from System.Collections.Generic import IReadOnlyList_1, IReadOnlyDictionary_2
from JAStudio.Core.Importing import ImportProfile

class AnkiNoteType:
    def __init__(self, name: str, fieldNames: IReadOnlyList_1[str]) -> None: ...
    @property
    def FieldNames(self) -> IReadOnlyList_1[str]: ...
    @property
    def Name(self) -> str: ...
    def ToString(self) -> str: ...


class IAnkiRawNotes(typing.Protocol):
    @abc.abstractmethod
    def Delete(self, rawNotes: IReadOnlyList_1[RawNote]) -> None: ...
    @abc.abstractmethod
    def NoteTypesForRawNotes(self) -> IReadOnlyList_1[AnkiNoteType]: ...
    @abc.abstractmethod
    def SelectedBy(self, profile: ImportProfile) -> IReadOnlyList_1[RawNote]: ...
    @abc.abstractmethod
    def TagAsImported(self, rawNotes: IReadOnlyList_1[RawNote]) -> None: ...


class RawNote:
    def __init__(self, ankiNoteId: int, fieldsByName: IReadOnlyDictionary_2[str, str], tags: IReadOnlyList_1[str]) -> None: ...
    ImportedTag : str
    @property
    def AnkiNoteId(self) -> int: ...
    @property
    def IsTaggedAsImported(self) -> bool: ...
    @property
    def Tags(self) -> IReadOnlyList_1[str]: ...
    def Field(self, ankiFieldName: str) -> str: ...
    def ToString(self) -> str: ...

