import typing
from JAStudio.Core.Importing.RawNotes import RawNote
from System.Collections.Generic import IReadOnlyList_1

class CheckedRawNote:
    def __init__(self, rawNote: RawNote, outcome: RawNoteOutcome, question: FieldCheck, externalId: FieldCheck, audio: FieldCheck, screenshot: FieldCheck, whatIsWrongWithTheNoteAsAWhole: IReadOnlyList_1[str]) -> None: ...
    @property
    def Audio(self) -> FieldCheck: ...
    @property
    def ExternalId(self) -> FieldCheck: ...
    @property
    def Outcome(self) -> RawNoteOutcome: ...
    @property
    def Question(self) -> FieldCheck: ...
    @property
    def RawNote(self) -> RawNote: ...
    @property
    def Screenshot(self) -> FieldCheck: ...
    @property
    def WhatIsWrong(self) -> IReadOnlyList_1[str]: ...
    def ToString(self) -> str: ...


class CheckMark(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    Fine : CheckMark # 0
    Neutral : CheckMark # 1
    AlreadyInJAStudio : CheckMark # 2
    Problem : CheckMark # 3


class FieldCheck:
    def __init__(self, mark: CheckMark, value: str, finding: str, whatIsWrong: IReadOnlyList_1[str]) -> None: ...
    @property
    def Finding(self) -> str: ...
    @property
    def Mark(self) -> CheckMark: ...
    @property
    def Value(self) -> str: ...
    @property
    def WhatIsWrong(self) -> IReadOnlyList_1[str]: ...
    @staticmethod
    def AlreadyInJAStudio(value: str, finding: str, whatIsWrong: str) -> FieldCheck: ...
    @staticmethod
    def Fine(value: str, finding: str) -> FieldCheck: ...
    @staticmethod
    def Neutral(value: str, finding: str) -> FieldCheck: ...
    @staticmethod
    def NotMapped() -> FieldCheck: ...
    @staticmethod
    def OfAMediaField(fileChecks: IReadOnlyList_1[FieldCheck]) -> FieldCheck: ...
    @staticmethod
    def Problem(value: str, finding: str, whatIsWrong: str) -> FieldCheck: ...
    @staticmethod
    def ProblemOfTheNoteAsAWhole(value: str, finding: str) -> FieldCheck: ...
    def ToString(self) -> str: ...


class ImportProfileProblem:
    def __init__(self, description: str) -> None: ...
    @property
    def Description(self) -> str: ...
    def ToString(self) -> str: ...


class RawNoteOutcome(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    WillBeImported : RawNoteOutcome # 0
    ImportedByAnEarlierRun : RawNoteOutcome # 1
    AlreadyInJAStudio : RawNoteOutcome # 2
    Problem : RawNoteOutcome # 3

