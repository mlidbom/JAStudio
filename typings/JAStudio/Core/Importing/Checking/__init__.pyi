import typing
from JAStudio.Core.Importing.RawNotes import RawNote
from System.Collections.Generic import IReadOnlyList_1

class CheckedRawNote:
    def __init__(self, rawNote: RawNote, question: str, externalId: str, outcome: RawNoteOutcome, findings: IReadOnlyList_1[RawNoteFinding]) -> None: ...
    @property
    def ExternalId(self) -> str: ...
    @property
    def Findings(self) -> IReadOnlyList_1[RawNoteFinding]: ...
    @property
    def Outcome(self) -> RawNoteOutcome: ...
    @property
    def Question(self) -> str: ...
    @property
    def RawNote(self) -> RawNote: ...
    def ToString(self) -> str: ...


class ImportProfileProblem:
    def __init__(self, description: str) -> None: ...
    @property
    def Description(self) -> str: ...
    def ToString(self) -> str: ...


class RawNoteFinding:
    def __init__(self, kind: RawNoteFindingKind, description: str) -> None: ...
    @property
    def Description(self) -> str: ...
    @property
    def Kind(self) -> RawNoteFindingKind: ...
    @staticmethod
    def AlreadyInJAStudio(description: str) -> RawNoteFinding: ...
    @staticmethod
    def Information(description: str) -> RawNoteFinding: ...
    @staticmethod
    def Problem(description: str) -> RawNoteFinding: ...
    def ToString(self) -> str: ...


class RawNoteFindingKind(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    Information : RawNoteFindingKind # 0
    AlreadyInJAStudio : RawNoteFindingKind # 1
    Problem : RawNoteFindingKind # 2


class RawNoteOutcome(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    WillBeImported : RawNoteOutcome # 0
    ImportedByAnEarlierRun : RawNoteOutcome # 1
    AlreadyInJAStudio : RawNoteOutcome # 2
    Problem : RawNoteOutcome # 3

