from JAStudio.Core.LanguageServices.Parsing.WordExtraction.Matches.Requirements import MatchRequirement
from JAStudio.Core.Note.Vocabulary.Matching.Conditions import Condition_1
from JAStudio.Core.LanguageServices.Parsing.WordExtraction import CandidateWordVariant

class FailedMatchRequirement(MatchRequirement):
    @property
    def FailureReason(self) -> str: ...
    @property
    def IsFulfilled(self) -> bool: ...
    @property
    def Reason(self) -> str: ...
    @staticmethod
    def Forbids(message: str) -> FailedMatchRequirement: ...
    @staticmethod
    def NotMet(condition: Condition_1[CandidateWordVariant]) -> FailedMatchRequirement: ...
    @staticmethod
    def Required(message: str) -> FailedMatchRequirement: ...

