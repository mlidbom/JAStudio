import abc
from JAStudio.Core.LanguageServices.Parsing.WordExtraction import BreakdownParsingOptions, TextAnalysisLocation, CandidateWordVariant, CandidateWord
from JAStudio.Core.Note.Sentences import SentenceConfiguration
from JAStudio.Core.LanguageServices.Parsing.WordExtraction.Matches import Match, VocabMatch
from JAStudio.Core.Note.Vocabulary.Matching import VocabMatchingRequireForbidFlags

class CustomForbidsNoCache(MatchRequirement):
    @property
    def Description(self) -> str: ...
    @property
    def FailureReason(self) -> str: ...
    @property
    def IsFulfilled(self) -> bool: ...
    @property
    def IsInState(self) -> bool: ...


class MatchInspector:
    @property
    def BreakdownParsingOptions(self) -> BreakdownParsingOptions: ...
    @property
    def CompoundLocationsAllHaveValidNonCompoundMatches(self) -> bool: ...
    @property
    def Configuration(self) -> SentenceConfiguration: ...
    @property
    def EndLocation(self) -> TextAnalysisLocation: ...
    @property
    def HasGodanImperativePart(self) -> bool: ...
    @property
    def HasGodanPotentialEnding(self) -> bool: ...
    @property
    def HasGodanPotentialStart(self) -> bool: ...
    @property
    def IsBase(self) -> bool: ...
    @property
    def IsCompoundEndingOnDictionaryFormWhereSurfaceDiffersFromBase(self) -> bool: ...
    @property
    def IsEndOfStatement(self) -> bool: ...
    @property
    def IsIchidanCoveringGodanPotential(self) -> bool: ...
    @property
    def IsVerbDictionaryFormCompound(self) -> bool: ...
    @property
    def Match(self) -> Match: ...
    @property
    def Prefix(self) -> str: ...
    @property
    def PreviousLocation(self) -> TextAnalysisLocation: ...
    @property
    def StartLocation(self) -> TextAnalysisLocation: ...
    @property
    def StartLocationIsDictionaryVerbInflection(self) -> bool: ...
    @property
    def SurfaceVariant(self) -> CandidateWordVariant: ...
    @property
    def Variant(self) -> CandidateWordVariant: ...
    @property
    def Word(self) -> CandidateWord: ...


class MatchRequirement(abc.ABC):
    @property
    def FailureReason(self) -> str: ...
    @property
    def IsFulfilled(self) -> bool: ...
    def ToString(self) -> str: ...


class VocabMatchInspector(MatchInspector):
    def __init__(self, match: VocabMatch) -> None: ...
    @property
    def BreakdownParsingOptions(self) -> BreakdownParsingOptions: ...
    @property
    def CompoundLocationsAllHaveValidNonCompoundMatches(self) -> bool: ...
    @property
    def Configuration(self) -> SentenceConfiguration: ...
    @property
    def EndLocation(self) -> TextAnalysisLocation: ...
    @property
    def HasGodanImperativePart(self) -> bool: ...
    @property
    def HasGodanPotentialEnding(self) -> bool: ...
    @property
    def HasGodanPotentialStart(self) -> bool: ...
    @property
    def IsBase(self) -> bool: ...
    @property
    def IsCompoundEndingOnDictionaryFormWhereSurfaceDiffersFromBase(self) -> bool: ...
    @property
    def IsEndOfStatement(self) -> bool: ...
    @property
    def IsIchidanCoveringGodanPotential(self) -> bool: ...
    @property
    def IsVerbDictionaryFormCompound(self) -> bool: ...
    @property
    def Match(self) -> VocabMatch: ...
    @property
    def Match(self) -> Match: ...
    @property
    def Prefix(self) -> str: ...
    @property
    def PreviousLocation(self) -> TextAnalysisLocation: ...
    @property
    def RequiresForbids(self) -> VocabMatchingRequireForbidFlags: ...
    @property
    def StartLocation(self) -> TextAnalysisLocation: ...
    @property
    def StartLocationIsDictionaryVerbInflection(self) -> bool: ...
    @property
    def SurfaceVariant(self) -> CandidateWordVariant: ...
    @property
    def Variant(self) -> CandidateWordVariant: ...
    @property
    def Word(self) -> CandidateWord: ...

