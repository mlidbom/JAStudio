from System.Collections.Generic import IReadOnlyList_1, IEnumerable_1
from JAStudio.Core.Reservoir.Sources import SourceSentence
from System import IDisposable
from JAStudio.Core.Importing.RawNotes import AnkiNoteType, RawNote
from System.IO.Compression import ZipArchiveEntry, ZipArchive
from System.IO import FileInfo, DirectoryInfo
from JAStudio.Core.Reservoir import ReservoirSentenceText

class AnkiDeck:
    def __init__(self, database: AnkiPackageDatabase) -> None: ...
    @property
    def FieldRoles(self) -> IReadOnlyList_1[DeckFieldRoles]: ...
    def Sentences(self) -> IEnumerable_1[SourceSentence]: ...


class AnkiPackageDatabase(IDisposable):
    CollectionFileNamesNewestFirst : IReadOnlyList_1[str]
    @property
    def NoteTypes(self) -> IReadOnlyList_1[AnkiNoteType]: ...
    @staticmethod
    def CollectionEntryIn(package: ZipArchive) -> ZipArchiveEntry: ...
    def Dispose(self) -> None: ...
    @staticmethod
    def InCollectionFile(collectionFile: FileInfo) -> AnkiPackageDatabase: ...
    @staticmethod
    def InPackage(package: FileInfo) -> AnkiPackageDatabase: ...
    def NotesOf(self, noteType: AnkiNoteType) -> IEnumerable_1[RawNote]: ...


class DeckFieldRoles:
    @property
    def AudioField(self) -> str: ...
    @property
    def ImageField(self) -> str: ...
    @property
    def JapaneseField(self) -> str: ...
    @property
    def JapaneseFieldHoldsFurigana(self) -> bool: ...
    @property
    def JapaneseFieldHoldsWordsRatherThanSentences(self) -> bool: ...
    @property
    def NoteType(self) -> AnkiNoteType: ...
    @property
    def TranslationField(self) -> str: ...
    def JapaneseTextOf(self, note: RawNote) -> ReservoirSentenceText: ...
    @staticmethod
    def RecognizedIn(noteType: AnkiNoteType, sample: IReadOnlyList_1[RawNote]) -> DeckFieldRoles: ...
    def SentenceOf(self, note: RawNote) -> SourceSentence: ...
    def ToString(self) -> str: ...


class DeckOnDisk:
    @property
    def Location(self) -> str: ...
    @property
    def Name(self) -> str: ...
    @staticmethod
    def EveryDeckIn(folder: DirectoryInfo) -> IEnumerable_1[DeckOnDisk]: ...
    def OpenDatabase(self) -> AnkiPackageDatabase: ...


class WhatADeckGives:
    @property
    def Deck(self) -> DeckOnDisk: ...
    @property
    def NoteTypes(self) -> IReadOnlyList_1[WhatANoteTypeGives]: ...
    @property
    def SentenceCount(self) -> int: ...
    @staticmethod
    def Of(deck: DeckOnDisk) -> WhatADeckGives: ...


class WhatANoteTypeGives:
    @property
    def AverageTextLength(self) -> float: ...
    @property
    def Deck(self) -> DeckOnDisk: ...
    @property
    def Examples(self) -> IReadOnlyList_1[ReservoirSentenceText]: ...
    @property
    def GivesNothingFromItsNotes(self) -> bool: ...
    @property
    def GivesWordsRatherThanSentences(self) -> bool: ...
    @property
    def NoteCount(self) -> int: ...
    @property
    def NoteType(self) -> AnkiNoteType: ...
    @property
    def Roles(self) -> DeckFieldRoles: ...
    @property
    def SentenceCount(self) -> int: ...
    @property
    def TextCount(self) -> int: ...
    @staticmethod
    def Of(deck: DeckOnDisk, roles: DeckFieldRoles, database: AnkiPackageDatabase) -> WhatANoteTypeGives: ...

