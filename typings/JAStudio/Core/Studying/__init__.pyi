import typing, abc
from JAStudio.Core.Note import NoteId
from JAStudio.Core.TaskRunners import TaskRunner
from System.Collections.Generic import IReadOnlyCollection_1, Dictionary_2, List_1, IReadOnlyList_1, IEnumerable_1, IReadOnlyDictionary_2

class CardStudyingStatus:
    def __init__(self, studyNoteId: int, cardType: str, isSuspended: bool, noteTypeName: str) -> None: ...
    @property
    def CardType(self) -> str: ...
    @property
    def IsSuspended(self) -> bool: ...
    @property
    def NoteTypeName(self) -> str: ...
    @property
    def StudyNoteId(self) -> int: ...


class ISpacedRepetitionSystemCardOperations(typing.Protocol):
    @abc.abstractmethod
    def DeleteTheStudyNoteOf(self, noteId: NoteId) -> None: ...
    @abc.abstractmethod
    def SuspendAllCardsForNote(self, noteId: NoteId) -> None: ...
    @abc.abstractmethod
    def UnsuspendAllCardsForNote(self, noteId: NoteId) -> None: ...


class ISpacedRepetitionSystemDataLoader(typing.Protocol):
    @abc.abstractmethod
    def Load(self, taskRunner: TaskRunner) -> SpacedRepetitionSystemData: ...


class ISpacedRepetitionSystemTagOperations(typing.Protocol):
    @abc.abstractmethod
    def AddTheTagToTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInTheSpacedRepetitionSystem: str) -> None: ...
    @abc.abstractmethod
    def DeleteTheBranchFromEveryNoteInTheSpacedRepetitionSystem(self, pathInTheSpacedRepetitionSystem: str) -> None: ...
    @abc.abstractmethod
    def NumberOfNotesInTheSpacedRepetitionSystemWithATagIn(self, pathInTheSpacedRepetitionSystem: str) -> int: ...
    @abc.abstractmethod
    def RemoveTheTagFromTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInTheSpacedRepetitionSystem: str) -> None: ...
    @abc.abstractmethod
    def RenameTheBranchOnEveryNoteInTheSpacedRepetitionSystem(self, pathInTheSpacedRepetitionSystem: str, renamedPathInTheSpacedRepetitionSystem: str) -> None: ...


class ISpacedRepetitionSystemWindows(typing.Protocol):
    @abc.abstractmethod
    def OpenTheBrowserOn(self, ankiSearch: str) -> None: ...
    @abc.abstractmethod
    def OpenThePreviewerOn(self, ankiSearch: str) -> None: ...
    @abc.abstractmethod
    def Refresh(self) -> None: ...
    @abc.abstractmethod
    def ShowAPassingMessage(self, message: str) -> None: ...


class NoSpacedRepetitionSystemWindows(ISpacedRepetitionSystemWindows):
    def __init__(self) -> None: ...
    def OpenTheBrowserOn(self, ankiSearch: str) -> None: ...
    def OpenThePreviewerOn(self, ankiSearch: str) -> None: ...
    def Refresh(self) -> None: ...
    def ShowAPassingMessage(self, message: str) -> None: ...


class SpacedRepetitionSystemAvailability:
    Available : SpacedRepetitionSystemAvailability
    Unavailable : SpacedRepetitionSystemAvailability
    @property
    def IsAvailable(self) -> bool: ...


class SpacedRepetitionSystemData:
    def __init__(self, noteIdOfEachStudyNote: Dictionary_2[int, NoteId], studyingStatuses: List_1[CardStudyingStatus], studyNoteTags: Dictionary_2[int, IReadOnlyList_1[str]]) -> None: ...
    @property
    def NoteIdOfEachStudyNote(self) -> Dictionary_2[int, NoteId]: ...
    @property
    def StudyingStatuses(self) -> List_1[CardStudyingStatus]: ...
    @property
    def StudyNoteTags(self) -> Dictionary_2[int, IReadOnlyList_1[str]]: ...
    def StudyingStatusesOf(self, studyNoteId: int) -> IEnumerable_1[CardStudyingStatus]: ...
    def TagsOf(self, studyNoteId: int) -> IReadOnlyList_1[str]: ...


class StudyNoteIds:
    def __init__(self) -> None: ...
    def Clear(self) -> None: ...
    def NoteIdOfTheStudyNote(self, studyNoteId: int) -> NoteId: ...
    def Register(self, studyNoteId: int, noteId: NoteId) -> None: ...
    def RequiredStudyNoteIdOf(self, noteId: NoteId) -> int: ...
    def Snapshot(self) -> IReadOnlyDictionary_2[int, NoteId]: ...
    def StudyNoteIdOf(self, noteId: NoteId) -> typing.Optional[int]: ...
    def TakeIn(self, readFromTheSpacedRepetitionSystem: IReadOnlyDictionary_2[int, NoteId], heldWhenTheReadBegan: IReadOnlyDictionary_2[int, NoteId]) -> IReadOnlyList_1[NoteId]: ...
    def Unregister(self, studyNoteId: int) -> None: ...

