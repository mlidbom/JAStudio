import typing, abc
from JAStudio.Core.Storage.Media import AudioAttachment
from System.Collections.Generic import IReadOnlyCollection_1, IReadOnlyList_1, IReadOnlyDictionary_2, IEnumerable_1
from JAStudio.Core.Note import NoteId, JPNote
from System import TimeSpan, IObservable_1, DateTime
from JAStudio.Core.Studying.StudyNotes import StudyNoteInTheSRS

class CardStudyingStatus:
    def __init__(self, studyNoteId: int, cardType: str, isSuspended: bool, noteTypeName: str) -> None: ...
    @property
    def CardType(self) -> str: ...
    @property
    def IsSuspended(self) -> bool: ...
    @property
    def NoteTypeName(self) -> str: ...
    @property
    def StudyNoteId(self) -> int: ...


class ISRSMedia(typing.Protocol):
    @abc.abstractmethod
    def Add(self, audio: AudioAttachment) -> None: ...


class ISRSTagOperations(typing.Protocol):
    @abc.abstractmethod
    def AddTheTagToTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInTheSRS: str) -> None: ...
    @abc.abstractmethod
    def DeleteTheBranchFromEveryNoteInTheSRS(self, pathInTheSRS: str) -> None: ...
    @abc.abstractmethod
    def NumberOfNotesInTheSRSWithATagIn(self, pathInTheSRS: str) -> int: ...
    @abc.abstractmethod
    def RemoveTheTagFromTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInTheSRS: str) -> None: ...
    @abc.abstractmethod
    def RenameTheBranchOnEveryNoteInTheSRS(self, pathInTheSRS: str, renamedPathInTheSRS: str) -> None: ...


class ISRSWindows(typing.Protocol):
    @abc.abstractmethod
    def OpenTheBrowserOn(self, studyNoteIds: IReadOnlyCollection_1[int]) -> None: ...
    @abc.abstractmethod
    def OpenThePreviewerOn(self, studyNoteId: int) -> None: ...
    @abc.abstractmethod
    def Refresh(self) -> None: ...
    # Skipped ShowAPassingMessage due to it being static, abstract and generic.

    ShowAPassingMessage : ShowAPassingMessage_MethodGroup
    class ShowAPassingMessage_MethodGroup:
        @typing.overload
        def __call__(self, message: str) -> None:...
        @typing.overload
        def __call__(self, message: str, shownFor: TimeSpan) -> None:...



class NoSRSMedia(ISRSMedia):
    def __init__(self) -> None: ...
    def Add(self, audio: AudioAttachment) -> None: ...


class NoSRSWindows(ISRSWindows):
    def __init__(self) -> None: ...
    def OpenTheBrowserOn(self, studyNoteIds: IReadOnlyCollection_1[int]) -> None: ...
    def OpenThePreviewerOn(self, studyNoteId: int) -> None: ...
    def Refresh(self) -> None: ...
    def ShowAPassingMessage(self, message: str, shownFor: TimeSpan) -> None: ...


class SRSAvailability(abc.ABC):
    Unavailable : SRSAvailability
    @property
    def CanBeUsedNow(self) -> bool: ...
    @property
    def IsAvailable(self) -> bool: ...
    @property
    def WhyItCannotBeUsedNow(self) -> str: ...


class SRSSync:
    @property
    def Completed(self) -> IObservable_1[SRSSyncReport]: ...
    @property
    def IsRunning(self) -> bool: ...
    @property
    def IsRunningChanged(self) -> IObservable_1[bool]: ...
    @property
    def LastReport(self) -> SRSSyncReport: ...
    @property
    def WhyItCannotRunNow(self) -> str: ...
    def Run(self) -> SRSSyncReport: ...


class SRSSyncReport:
    @property
    def FinishedAt(self) -> DateTime: ...
    @property
    def NotesWhoseStudyNoteHadChanged(self) -> IReadOnlyList_1[JPNote]: ...
    @property
    def NotesWhoseStudyNoteIsGone(self) -> IReadOnlyList_1[JPNote]: ...
    @property
    def NotesWhoseStudyNoteWasWritten(self) -> IReadOnlyList_1[JPNote]: ...
    @property
    def StudyNotesRead(self) -> int: ...
    @property
    def StudyNotesThatHoldNoNotesId(self) -> IReadOnlyList_1[StudyNoteInTheSRS]: ...
    @property
    def StudyNotesWhoseNoteTheCollectionHasNot(self) -> IReadOnlyList_1[StudyNoteInTheSRS]: ...


class StudyNoteIds:
    def __init__(self) -> None: ...
    def Clear(self) -> None: ...
    def NoteIdOfTheStudyNote(self, studyNoteId: int) -> NoteId: ...
    def Register(self, studyNoteId: int, noteId: NoteId) -> None: ...
    def RequiredStudyNoteIdOf(self, noteId: NoteId) -> int: ...
    def Snapshot(self) -> IReadOnlyDictionary_2[int, NoteId]: ...
    def StudyNoteIdOf(self, noteId: NoteId) -> typing.Optional[int]: ...
    def StudyNoteIdsOf(self, notes: IEnumerable_1[JPNote]) -> IReadOnlyList_1[int]: ...
    def TakeIn(self, readFromTheSRS: IReadOnlyDictionary_2[int, NoteId], heldWhenTheReadBegan: IReadOnlyDictionary_2[int, NoteId]) -> IReadOnlyList_1[NoteId]: ...

