import typing
from JAStudio.Core.UI.Web import IWorkspaceToggles, IWebPageImages
from JAStudio.Core.Note import JPNote
from Avalonia import Application, AvaloniaProperty
from Avalonia.Styling import ThemeVariant, Styles
from Avalonia.Controls.ApplicationLifetimes import IApplicationLifetime
from Avalonia.Controls.Templates import DataTemplates
from Avalonia.Threading import Dispatcher
from Avalonia.Platform import IPlatformSettings
from Avalonia.Controls import IResourceDictionary
from JAStudio.Core import TemporaryServiceCollection
from System import TimeSpan
from Avalonia.Data import IndexerDescriptor, BindingBase

class AnkiDialogs(IWorkspaceToggles):
    def __init__(self) -> None: ...
    def ShowTheNoteInTheWorkspace(self, note: JPNote) -> None: ...
    def ToggleNoteSearch(self) -> None: ...
    def ToggleWorkspaceWindow(self) -> None: ...


class UIApp(Application):
    def __init__(self) -> None: ...
    @property
    def ActualThemeVariant(self) -> ThemeVariant: ...
    @property
    def ApplicationLifetime(self) -> IApplicationLifetime: ...
    @ApplicationLifetime.setter
    def ApplicationLifetime(self, value: IApplicationLifetime) -> IApplicationLifetime: ...
    @property
    def DataContext(self) -> typing.Any: ...
    @DataContext.setter
    def DataContext(self, value: typing.Any) -> typing.Any: ...
    @property
    def DataTemplates(self) -> DataTemplates: ...
    @property
    def Dispatcher(self) -> Dispatcher: ...
    @property
    def Name(self) -> str: ...
    @Name.setter
    def Name(self, value: str) -> str: ...
    @property
    def PlatformSettings(self) -> IPlatformSettings: ...
    @property
    def RequestedThemeVariant(self) -> ThemeVariant: ...
    @RequestedThemeVariant.setter
    def RequestedThemeVariant(self, value: ThemeVariant) -> ThemeVariant: ...
    @property
    def Resources(self) -> IResourceDictionary: ...
    @Resources.setter
    def Resources(self, value: IResourceDictionary) -> IResourceDictionary: ...
    @property
    def Styles(self) -> Styles: ...
    def Initialize(self) -> None: ...
    @staticmethod
    def InitializeWorkspaceWindow(services: TemporaryServiceCollection) -> None: ...
    @staticmethod
    def InitializeWorkspaceWindowShowingPagesAsImages(services: TemporaryServiceCollection, webPageImages: IWebPageImages) -> None: ...
    def OnFrameworkInitializationCompleted(self) -> None: ...
    @staticmethod
    def WaitForInitialization(timeout: TimeSpan) -> None: ...
    def __getitem__(self, property: AvaloniaProperty) -> typing.Any: ...
    def __setitem__(self, property: AvaloniaProperty, value: typing.Any) -> None: ...
    def __getitem__(self, binding: IndexerDescriptor) -> BindingBase: ...
    def __setitem__(self, binding: IndexerDescriptor, value: BindingBase) -> None: ...

