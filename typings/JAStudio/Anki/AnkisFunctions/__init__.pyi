import typing, abc
from System.Collections.Generic import IReadOnlyList_1, List_1, IReadOnlyDictionary_2
from System import TimeSpan

class IAnkisDatabase(typing.Protocol):
    @abc.abstractmethod
    def ReadJson(self, select: str) -> str: ...


class IAnkisMedia(typing.Protocol):
    @property
    def Folder(self) -> str: ...
    @abc.abstractmethod
    def AddFile(self, filePath: str) -> str: ...


class IAnkisNotes(typing.Protocol):
    @abc.abstractmethod
    def AddTag(self, noteIds: IReadOnlyList_1[int], tag: str) -> None: ...
    @abc.abstractmethod
    def Find(self, search: str) -> List_1[int]: ...
    @abc.abstractmethod
    def SuspendAllCardsOf(self, noteId: int) -> None: ...
    @abc.abstractmethod
    def UnsuspendAllCardsOf(self, noteId: int) -> None: ...
    @abc.abstractmethod
    def WriteTheFields(self, noteId: int, fields: IReadOnlyDictionary_2[str, str]) -> None: ...
    # Skipped Delete due to it being static, abstract and generic.

    Delete : Delete_MethodGroup
    class Delete_MethodGroup:
        @typing.overload
        def __call__(self, noteId: int) -> None:...
        @typing.overload
        def __call__(self, noteIds: IReadOnlyList_1[int]) -> None:...



class IAnkisTags(typing.Protocol):
    @abc.abstractmethod
    def AddToNotes(self, noteIds: IReadOnlyList_1[int], tag: str) -> None: ...
    @abc.abstractmethod
    def Delete(self, path: str) -> None: ...
    @abc.abstractmethod
    def NumberOfNotesWithATagIn(self, path: str) -> int: ...
    @abc.abstractmethod
    def RemoveFromNotes(self, noteIds: IReadOnlyList_1[int], tag: str) -> None: ...
    @abc.abstractmethod
    def Rename(self, path: str, renamedPath: str) -> None: ...


class IAnkisWindows(typing.Protocol):
    @abc.abstractmethod
    def OpenTheBrowserAndThePreviewerOn(self, search: str) -> None: ...
    @abc.abstractmethod
    def OpenTheBrowserOn(self, search: str) -> None: ...
    @abc.abstractmethod
    def Refresh(self) -> None: ...
    @abc.abstractmethod
    def ShowATooltip(self, message: str, shownFor: TimeSpan) -> None: ...

