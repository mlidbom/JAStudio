import typing, abc
from JAStudio.Core import IEnvironmentPaths
from System.Collections.Generic import IReadOnlyList_1, IReadOnlyCollection_1
from JAStudio.Core.Importing.RawNotes import IAnkiRawNotes, RawNote, AnkiNoteType
from JAStudio.Anki.CollectionDatabase import AnkiCollectionDatabase
from JAStudio.Core.Importing import ImportProfile
from JAStudio.Core.Studying import SRSAvailability, ISRSMedia, ISRSWindows, StudyNoteIds, ISRSTagOperations
from JAStudio.Core.Storage.Media import AudioAttachment
from System import TimeSpan
from JAStudio.Core.Studying.StudyNotes import ISRSStudyNotes, StudyNoteInTheSRS
from JAStudio.Core.Note import NoteId, JPNote
from JAStudio.Core.Note.Collection import JPCollection
from JAStudio.Core.TaskRunners import BackgroundTaskManager

class AnkiEnvironmentPaths(IEnvironmentPaths):
    def __init__(self) -> None: ...
    @property
    def AddonRootDir(self) -> str: ...
    @property
    def AnkiMediaDir(self) -> str: ...
    @property
    def DatabaseDir(self) -> str: ...
    @property
    def MediaDir(self) -> str: ...
    @property
    def UserFilesDir(self) -> str: ...


class AnkiFacade(abc.ABC):
    @staticmethod
    def GetAddonRootDir() -> str: ...
    @staticmethod
    def GetAnkiMediaDir() -> str: ...
    @staticmethod
    def GetNoteIdFromCardId(cardId: int) -> int: ...

    class Browser(abc.ABC):
        @staticmethod
        def ExecuteLookup(query: str) -> None: ...
        @staticmethod
        def ExecuteLookupAndShowPreviewer(query: str) -> None: ...

        class MenuActions(abc.ABC):
            @staticmethod
            def PrioritizeCards(cardIds: IReadOnlyList_1[int]) -> None: ...
            @staticmethod
            def SpreadCardsOverDays(cardIds: IReadOnlyList_1[int], startDay: int, daysApart: int) -> None: ...



    class UIUtils(abc.ABC):
        @staticmethod
        def Refresh() -> None: ...
        @staticmethod
        def ShowTooltip(message: str, periodMs: int) -> None: ...



class AnkiLifecycleEvent(typing.SupportsInt):
    @typing.overload
    def __init__(self, value : int) -> None: ...
    @typing.overload
    def __init__(self, value : int, force_if_true: bool) -> None: ...
    def __int__(self) -> int: ...
    
    # Values:
    ProfileOpened : AnkiLifecycleEvent # 0
    ProfileClosing : AnkiLifecycleEvent # 1
    SyncStarting : AnkiLifecycleEvent # 2
    SyncCompleted : AnkiLifecycleEvent # 3


class AnkiRawNotes(IAnkiRawNotes):
    def __init__(self, database: AnkiCollectionDatabase) -> None: ...
    def Delete(self, rawNotes: IReadOnlyList_1[RawNote]) -> None: ...
    def NoteTypesForRawNotes(self) -> IReadOnlyList_1[AnkiNoteType]: ...
    def SelectedBy(self, profile: ImportProfile) -> IReadOnlyList_1[RawNote]: ...
    def TagAsImported(self, rawNotes: IReadOnlyList_1[RawNote]) -> None: ...


class AnkisAvailability(SRSAvailability):
    def __init__(self) -> None: ...
    @property
    def CanBeUsedNow(self) -> bool: ...
    @property
    def IsAvailable(self) -> bool: ...
    @property
    def WhyItCannotBeUsedNow(self) -> str: ...
    def TakeIn(self, lifecycleEvent: AnkiLifecycleEvent) -> None: ...


class AnkisMediaFolder(ISRSMedia):
    def __init__(self) -> None: ...
    def Add(self, audio: AudioAttachment) -> None: ...


class AnkisOwnWindows(ISRSWindows):
    def __init__(self) -> None: ...
    def OpenTheBrowserOn(self, studyNoteIds: IReadOnlyCollection_1[int]) -> None: ...
    def OpenThePreviewerOn(self, studyNoteId: int) -> None: ...
    def Refresh(self) -> None: ...
    def ShowAPassingMessage(self, message: str, shownFor: TimeSpan) -> None: ...


class AnkiStudyNotes(ISRSStudyNotes):
    def __init__(self, database: AnkiCollectionDatabase, studyNoteIds: StudyNoteIds) -> None: ...
    def DeleteTheStudyNoteOf(self, noteId: NoteId) -> None: ...
    def ReadAll(self) -> IReadOnlyList_1[StudyNoteInTheSRS]: ...
    def SuspendAllCardsForNote(self, noteId: NoteId) -> None: ...
    def UnsuspendAllCardsForNote(self, noteId: NoteId) -> None: ...
    def Write(self, note: JPNote) -> None: ...


class AnkiTagOperations(ISRSTagOperations):
    def __init__(self, ankiNoteIds: StudyNoteIds) -> None: ...
    def AddTheTagToTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInAnki: str) -> None: ...
    def DeleteTheBranchFromEveryNoteInTheSRS(self, pathInAnki: str) -> None: ...
    def NumberOfNotesInTheSRSWithATagIn(self, pathInAnki: str) -> int: ...
    def RemoveTheTagFromTheStudyNotesOf(self, notes: IReadOnlyCollection_1[NoteId], tagInAnki: str) -> None: ...
    def RenameTheBranchOnEveryNoteInTheSRS(self, pathInAnki: str, renamedPathInAnki: str) -> None: ...


class FollowingAnkisLifecycle:
    def __init__(self, collection: JPCollection, ankisAvailability: AnkisAvailability, backgroundTasks: BackgroundTaskManager) -> None: ...
    def Handle(self, lifecycleEvent: AnkiLifecycleEvent) -> None: ...


class StudyNotesInAnkisDatabase(abc.ABC):
    @staticmethod
